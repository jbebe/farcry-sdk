<Window x:Class="SoundBench.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
        xmlns:views="clr-namespace:SoundBench.Views"
        Title="Sound Bench" Width="1400" Height="900" PreviewKeyDown="OnKey">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="Shown" />
        <Style x:Key="Heading" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="0,14,0,4" />
        </Style>
        <Style x:Key="Optional" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- On the focused selection's blue, the tree's grey and blue text turn light gray and white. -->
        <Style x:Key="MutedText" TargetType="TextBlock" BasedOn="{StaticResource Optional}">
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=TreeViewItem}}" Value="True" />
                        <Condition Binding="{Binding (primitives:Selector.IsSelectionActive), RelativeSource={RelativeSource AncestorType=TreeViewItem}}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Foreground" Value="LightGray" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CurveText" TargetType="TextBlock" BasedOn="{StaticResource Optional}">
            <Setter Property="Foreground" Value="{StaticResource VolumeCurveBrush}" />
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=TreeViewItem}}" Value="True" />
                        <Condition Binding="{Binding (primitives:Selector.IsSelectionActive), RelativeSource={RelativeSource AncestorType=TreeViewItem}}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Foreground" Value="White" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Margin" Value="0,0,4,4" />
        </Style>
        <Style x:Key="Pedal" TargetType="RadioButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
            <Setter Property="Padding" Value="10,10" />
            <Setter Property="Margin" Value="0,0,4,4" />
            <Setter Property="GroupName" Value="Drive" />
            <EventSetter Event="Checked" Handler="OnControls" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Top" Padding="8" BorderBrush="#DDDDDD" BorderThickness="0,0,0,1">
            <DockPanel>
                <Button x:Name="OpenButton" DockPanel.Dock="Right" Content="Open" Click="OnOpen"
                        AutomationProperties.AutomationId="Open" Margin="8,0,0,0" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="3*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Game" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBox x:Name="GamePath" Grid.Column="1" AutomationProperties.AutomationId="GamePath" />
                    <TextBlock Grid.Column="2" Text="Layers (;)" VerticalAlignment="Center" Margin="12,0,6,0" />
                    <TextBox x:Name="LayerPaths" Grid.Column="3" AutomationProperties.AutomationId="LayerPaths" />
                </Grid>
            </DockPanel>
        </Border>
        <TextBlock x:Name="Status" DockPanel.Dock="Bottom" Margin="8,4" AutomationProperties.AutomationId="Status" />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="400" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="8">
                    <TextBlock Text="Car" Style="{StaticResource Heading}" Margin="0,0,0,4" />
                    <ComboBox x:Name="Cars" SelectionChanged="OnCarSelected" AutomationProperties.AutomationId="Cars" />
                    <TextBlock x:Name="CarInfo" TextWrapping="Wrap" Margin="0,4" Foreground="{StaticResource TextMutedBrush}" />
                    <TextBlock x:Name="BankProblems" Style="{StaticResource Optional}" TextWrapping="Wrap" Margin="0,0,0,4"
                               Foreground="{StaticResource ProblemBrush}" AutomationProperties.AutomationId="BankProblems" />
                    <Button Content="Reload banks" Click="OnReload" HorizontalAlignment="Left"
                            AutomationProperties.AutomationId="Reload" />

                    <TextBlock Text="Engine" Style="{StaticResource Heading}" />
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Start engine" Click="OnStart" AutomationProperties.AutomationId="StartEngine" />
                        <Button Content="Stop engine" Click="OnStop" AutomationProperties.AutomationId="StopEngine" />
                        <TextBlock x:Name="EngineState" VerticalAlignment="Center" Margin="8,0,0,4"
                                   AutomationProperties.AutomationId="EngineState" />
                    </StackPanel>

                    <TextBlock Text="Drive  (W accelerate, Space coast, S brake, H hold gear)" Style="{StaticResource Heading}" />
                    <UniformGrid Columns="3">
                        <RadioButton x:Name="Accelerate" Content="Accelerate" Style="{StaticResource Pedal}"
                                     AutomationProperties.AutomationId="Accelerate" />
                        <RadioButton x:Name="Coast" Content="Coast" Style="{StaticResource Pedal}" IsChecked="True"
                                     AutomationProperties.AutomationId="Coast" />
                        <RadioButton x:Name="Brake" Content="Brake" Style="{StaticResource Pedal}"
                                     AutomationProperties.AutomationId="Brake" />
                    </UniformGrid>
                    <CheckBox x:Name="HoldGear" Content="Hold gear: no shifts, so the revs run up to the redline in this gear"
                              Checked="OnControls" Unchecked="OnControls" Margin="0,2,0,6"
                              AutomationProperties.AutomationId="HoldGear" />
                    <DockPanel>
                        <TextBlock Text="Throttle" Width="80" />
                        <TextBlock DockPanel.Dock="Right" Width="50" Text="{Binding Value, ElementName=ThrottleSlider, StringFormat={}{0:0} %}" />
                        <Slider x:Name="ThrottleSlider" Minimum="0" Maximum="100" Value="100" ValueChanged="OnControls"
                                AutomationProperties.AutomationId="Throttle" />
                    </DockPanel>
                    <DockPanel>
                        <TextBlock Text="Shift time" Width="80" />
                        <TextBlock DockPanel.Dock="Right" Width="50" Text="{Binding Value, ElementName=ShiftTime, StringFormat={}{0:0.00} s}" />
                        <Slider x:Name="ShiftTime" Minimum="0" Maximum="2" ValueChanged="OnControls"
                                AutomationProperties.AutomationId="ShiftTime" />
                    </DockPanel>

                    <TextBlock Text="Gauges" Style="{StaticResource Heading}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Speed" />
                        <TextBlock x:Name="SpeedText" Grid.Column="1" FontSize="16" AutomationProperties.AutomationId="Speed" />
                        <TextBlock Grid.Row="1" Text="Engine rpm" />
                        <TextBlock x:Name="RpmText" Grid.Row="1" Grid.Column="1" FontSize="16" AutomationProperties.AutomationId="Rpm" />
                        <ProgressBar x:Name="RpmBar" Grid.Row="2" Grid.ColumnSpan="2" Height="10" Margin="0,2,0,6" />
                        <TextBlock Grid.Row="3" Text="Gear" />
                        <TextBlock x:Name="GearText" Grid.Row="3" Grid.Column="1" AutomationProperties.AutomationId="Gear" />
                        <TextBlock Grid.Row="4" Text="Havok rpm" />
                        <TextBlock x:Name="HavokText" Grid.Row="4" Grid.Column="1" AutomationProperties.AutomationId="HavokRpm" />
                        <TextBlock Grid.Row="5" Text="Clutch" />
                        <TextBlock x:Name="ClutchText" Grid.Row="5" Grid.Column="1" AutomationProperties.AutomationId="Clutch" />
                    </Grid>

                    <TextBlock Text="Parameters" Style="{StaticResource Heading}" />
                    <ItemsControl x:Name="Parameters">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="55" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Name}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Value}" />
                                    <CheckBox Grid.Column="2" Content="Pin" IsChecked="{Binding Pinned}" Margin="0,0,6,0"
                                              AutomationProperties.AutomationId="{Binding Name, StringFormat=Pin {0}}" />
                                    <Slider Grid.Column="3" Minimum="{Binding Min}" Maximum="{Binding Max}"
                                            Value="{Binding PinValue}" IsEnabled="{Binding Pinned}"
                                            AutomationProperties.AutomationId="{Binding Name, StringFormat=Value {0}}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="Listening" Style="{StaticResource Heading}" />
                    <DockPanel>
                        <TextBlock Text="Distance" Width="80" />
                        <TextBlock DockPanel.Dock="Right" Width="50" Text="{Binding Value, ElementName=Distance, StringFormat={}{0:0.0} m}" />
                        <Slider x:Name="Distance" Minimum="0" Maximum="40" Value="0" ValueChanged="OnControls"
                                AutomationProperties.AutomationId="Distance" />
                    </DockPanel>
                    <DockPanel>
                        <TextBlock Text="Master" Width="80" />
                        <TextBlock DockPanel.Dock="Right" Width="50" Text="{Binding Value, ElementName=Master, StringFormat={}{0:0} dB}" />
                        <Slider x:Name="Master" Minimum="-40" Maximum="0" Value="-12" ValueChanged="OnControls"
                                AutomationProperties.AutomationId="Master" />
                    </DockPanel>
                    <DockPanel>
                        <TextBlock Text="Output" Width="80" />
                        <TextBlock x:Name="OutputText" AutomationProperties.AutomationId="Output" />
                    </DockPanel>
                    <DockPanel Margin="0,4,0,0">
                        <TextBlock Text="Surface" Width="80" VerticalAlignment="Center" />
                        <ComboBox x:Name="Surfaces" SelectionChanged="OnSurface" AutomationProperties.AutomationId="Surface" />
                    </DockPanel>
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="240" />
                </Grid.RowDefinitions>
                <TreeView x:Name="Voices" SelectedItemChanged="OnVoiceSelected" AutomationProperties.AutomationId="Voices">
                    <TreeView.ItemContainerStyle>
                        <Style TargetType="TreeViewItem">
                            <Setter Property="IsExpanded" Value="True" />
                        </Style>
                    </TreeView.ItemContainerStyle>
                    <TreeView.Resources>
                        <HierarchicalDataTemplate DataType="{x:Type views:SlotView}" ItemsSource="{Binding Plays}">
                            <StackPanel Orientation="Horizontal" Margin="0,3">
                                <TextBlock Text="{Binding Title}" FontWeight="Bold" />
                                <TextBlock Text="{Binding State}" Style="{StaticResource MutedText}" Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </HierarchicalDataTemplate>
                        <HierarchicalDataTemplate DataType="{x:Type views:NodeView}" ItemsSource="{Binding Children}">
                            <StackPanel Margin="0,2">
                                <StackPanel Orientation="Horizontal">
                                    <CheckBox Content="M" IsChecked="{Binding Muted}" ToolTip="Mute this and what plays under it" />
                                    <CheckBox Content="S" IsChecked="{Binding Soloed}" ToolTip="Solo this and what plays under it" Margin="6,0" />
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding State}" Style="{StaticResource MutedText}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                    <ProgressBar Width="90" Height="9" Maximum="1" Margin="8,0,0,0" Value="{Binding Meter, Mode=OneWay}"
                                                 Visibility="{Binding IsVoice, Converter={StaticResource Shown}}" />
                                    <TextBlock Text="{Binding Values}" Margin="8,0,0,0" />
                                </StackPanel>
                                <TextBlock Text="{Binding Curves}" Style="{StaticResource CurveText}" />
                                <TextBlock Text="{Binding Detail}" Style="{StaticResource MutedText}" />
                                <TextBlock Text="{Binding Problem}" Style="{StaticResource Optional}" Foreground="{StaticResource ProblemBrush}" />
                            </StackPanel>
                        </HierarchicalDataTemplate>
                    </TreeView.Resources>
                </TreeView>
                <DockPanel Grid.Row="1" Margin="6,4">
                    <Button x:Name="SaveButton" DockPanel.Dock="Right" Content="Save banks" Click="OnSave" IsEnabled="False"
                            Margin="8,0,0,0" AutomationProperties.AutomationId="Save" />
                    <TextBlock x:Name="UnsavedText" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="8,0,0,0"
                               Foreground="{StaticResource ProblemBrush}" AutomationProperties.AutomationId="Unsaved" />
                    <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{StaticResource TextMutedBrush}"
                               Text="Select a layer to edit its curves, drawn over the other layers' in grey: drag a point (Shift: only its value), double-click to add one, right-click to remove one, Ctrl+Z to undo. The wheel zooms, dragging the background pans. The red line is the parameter's value now." />
                </DockPanel>
                <UniformGrid x:Name="CurveEditors" Grid.Row="2" Rows="1" />
            </Grid>
        </Grid>
    </DockPanel>
</Window>
