<UserControl x:Class="JackAll.App.Move.MoveTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:move="clr-namespace:JackAll.App.Move">
    <UserControl.Resources>
        <HierarchicalDataTemplate x:Key="ObjectTemplate" DataType="{x:Type move:MoveTreeNode}"
                                  ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Label}" Foreground="#333" />
                <TextBlock Text="{Binding Detail}" Margin="8,0,0,0" FontSize="10.5" Foreground="#888"
                           VerticalAlignment="Center" />
            </StackPanel>
        </HierarchicalDataTemplate>
    </UserControl.Resources>

    <DockPanel Margin="6">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8" LastChildFill="False">
            <TextBlock Text="Graph:" VerticalAlignment="Center" Margin="0,0,6,0" />
            <ComboBox x:Name="GraphPicker" Width="380" VerticalAlignment="Center" IsEnabled="False" />
            <Button x:Name="LoadButton" Content="Load" Padding="10,5" Margin="16,0,0,0"
                    IsEnabled="False" Click="Load_Click" />
            <Button x:Name="ExportButton" Content="Export XML…" Padding="10,5" Margin="8,0,0,0"
                    IsEnabled="False" Click="Export_Click" />
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Margin="16,0,0,0" Foreground="#666"
                       Text="Pick a graph and Load" />
        </DockPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="420" MinWidth="240" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="*" MinWidth="320" />
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0">
                <TextBox x:Name="SearchBox" DockPanel.Dock="Top" Padding="4,2" Margin="0,0,0,6"
                         TextChanged="Filter_Changed" />

                <TreeView x:Name="ObjectTree" ItemTemplate="{StaticResource ObjectTemplate}"
                          BorderBrush="#CCC" BorderThickness="1"
                          VirtualizingStackPanel.IsVirtualizing="True"
                          VirtualizingStackPanel.VirtualizationMode="Recycling"
                          ScrollViewer.CanContentScroll="True"
                          SelectedItemChanged="ObjectTree_SelectedItemChanged">
                    <TreeView.Resources>
                        <Style TargetType="TreeViewItem">
                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsVisible}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TreeView.Resources>
                </TreeView>
            </DockPanel>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" Background="Transparent" />

            <DockPanel Grid.Column="2">
                <TextBlock x:Name="DetailHeader" DockPanel.Dock="Top" FontWeight="SemiBold"
                           Margin="0,0,0,6" Text="Select an object to see its fields" />
                <DataGrid x:Name="FieldGrid" AutoGenerateColumns="False" IsReadOnly="True"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                          BorderBrush="#CCC" BorderThickness="1" RowHeaderWidth="0"
                          EnableRowVirtualization="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Field" Binding="{Binding Name}" Width="240" />
                        <DataGridTextColumn Header="Type" Binding="{Binding Kind}" Width="90" />
                        <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="200" />
                        <DataGridTextColumn Header="Means" Binding="{Binding Note}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Grid>
    </DockPanel>
</UserControl>
