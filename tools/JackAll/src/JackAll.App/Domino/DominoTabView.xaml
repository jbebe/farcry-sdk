<UserControl x:Class="JackAll.App.Domino.DominoTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:text="clr-namespace:JackAll.App.FileHandlers.Text">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" MinWidth="240" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="1*" MinWidth="240" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#F3F3F3" BorderBrush="#DDD" BorderThickness="0,0,1,0" ClipToBounds="True">
            <Grid>
                <Canvas x:Name="GraphCanvas" Background="Transparent"
                        MouseDown="GraphCanvas_MouseDown" MouseUp="GraphCanvas_MouseUp"
                        MouseMove="GraphCanvas_MouseMove" MouseWheel="GraphCanvas_MouseWheel">
                    <Canvas.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="GraphScale" ScaleX="1" ScaleY="1" />
                            <TranslateTransform x:Name="GraphTranslate" X="20" Y="20" />
                        </TransformGroup>
                    </Canvas.RenderTransform>
                </Canvas>

                <Border Background="#DDFFFFFF" BorderBrush="#CCC" BorderThickness="1" CornerRadius="3"
                        HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8" Padding="8,4">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="StatusText" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" MaxWidth="480" />
                        <Button x:Name="ResetViewButton" Content="Reset view" Margin="12,0,0,0" Padding="6,2" Click="ResetViewButton_Click" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" Background="#DDD" />

        <text:TextFileHandler x:Name="SourceView" Grid.Column="2" Extension="lua" />
    </Grid>
</UserControl>
