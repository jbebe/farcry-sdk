<UserControl x:Class="JackAll.App.Domino.DominoTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:nodify="clr-namespace:Nodify;assembly=Nodify"
             xmlns:domino="clr-namespace:JackAll.App.Domino"
             xmlns:text="clr-namespace:JackAll.App.FileHandlers.Text">
    <UserControl.Resources>
        <ResourceDictionary>
            <!--
              Nodify's own light theme. Without it the library falls back to its dark defaults - light
              text on dark connectors and headers - which reads as broken against this app's light
              chrome and against the node fills below. Merged here rather than app-wide so it only
              affects this tab.
            -->
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Nodify;component/Themes/Light.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <domino:PortBrushConverter x:Key="PortBrush" />
            <domino:NodeBrushConverter x:Key="NodeBrush" />
            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <!--
          A port row reads as a slightly lighter tone of whatever node colour is behind it: the wash is
          translucent white, so it adapts to all four node fills without needing to know which one it
          is, and lifting the background rather than darkening it is what keeps the dark label text
          comfortably readable. Do NOT set Background on the NodeInput/NodeOutput itself - that paints
          the entire row, not the connector dot, which is what made these illegible before. The dot
          takes its colour from BorderBrush alone.
        -->
        <DataTemplate x:Key="InputPortTemplate" DataType="{x:Type domino:DominoConnectorViewModel}">
            <nodify:NodeInput IsConnected="{Binding IsConnected}"
                              Anchor="{Binding Anchor, Mode=OneWayToSource}"
                              ToolTip="{Binding Tooltip}"
                              Background="Transparent"
                              BorderBrush="{Binding Converter={StaticResource PortBrush}}">
                <nodify:NodeInput.Header>
                    <Border Background="#26FFFFFF" CornerRadius="3" Padding="5,1" Margin="0,1">
                        <StackPanel Orientation="Horizontal">
                            <!-- Stands in for a suppressed hub wire: names the graph variable the value
                                 arrives through, and clicks through to the box that produced it. -->
                            <Button Click="SupplierChip_Click" Cursor="Hand" Padding="0" BorderThickness="0"
                                    Background="Transparent" Margin="0,0,4,0"
                                    Visibility="{Binding HasSupplier, Converter={StaticResource BoolToVisibility}}">
                                <Border Background="#F2FFFFFF" BorderBrush="#99A6B4" BorderThickness="1"
                                        CornerRadius="7" Padding="5,0">
                                    <TextBlock Text="{Binding ChipText}" FontSize="10" Foreground="#2A3542" />
                                </Border>
                            </Button>
                            <TextBlock Text="{Binding Title}" FontSize="11"
                                       Foreground="{Binding Converter={StaticResource PortBrush}}"
                                       TextTrimming="CharacterEllipsis" MaxWidth="200" />
                        </StackPanel>
                    </Border>
                </nodify:NodeInput.Header>
            </nodify:NodeInput>
        </DataTemplate>

        <DataTemplate x:Key="OutputPortTemplate" DataType="{x:Type domino:DominoConnectorViewModel}">
            <nodify:NodeOutput IsConnected="{Binding IsConnected}"
                               Anchor="{Binding Anchor, Mode=OneWayToSource}"
                               ToolTip="{Binding Tooltip}"
                               Background="Transparent"
                               BorderBrush="{Binding Converter={StaticResource PortBrush}}">
                <nodify:NodeOutput.Header>
                    <Border Background="#26FFFFFF" CornerRadius="3" Padding="5,1" Margin="0,1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Title}" FontSize="11"
                                       Foreground="{Binding Converter={StaticResource PortBrush}}"
                                       TextTrimming="CharacterEllipsis" MaxWidth="200" />
                            <!-- A hub announces its reach, since its wires aren't drawn. -->
                            <Border Background="#F7EBC8" BorderBrush="#C79F45" BorderThickness="1"
                                    CornerRadius="7" Padding="5,0" Margin="4,0,0,0"
                                    Visibility="{Binding IsHub, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock FontSize="10" Foreground="#6A4E0C">
                                    <Run Text="→" /><Run Text="{Binding FanOut, Mode=OneWay}" />
                                </TextBlock>
                            </Border>
                        </StackPanel>
                    </Border>
                </nodify:NodeOutput.Header>
            </nodify:NodeOutput>
        </DataTemplate>

        <!-- Wires -->
        <DataTemplate x:Key="ControlWireTemplate" DataType="{x:Type domino:DominoConnectionViewModel}">
            <nodify:StepConnection Source="{Binding Source.Anchor}" Target="{Binding Target.Anchor}"
                                   Stroke="#5A6472" StrokeThickness="1.6"
                                   Direction="Forward" ArrowSize="7,7" />
        </DataTemplate>

        <!--
          The label needs a real background, not just a foreground - leave TextBackground unset and the
          pill has nothing behind the text at all. It is bound to the same brush as Stroke so the pill is
          a solid chip in the value's type colour whichever brush Nodify ends up painting it from, with
          white text on top. Every colour in PortBrushConverter is dark enough to clear 6:1 against white.
        -->
        <DataTemplate x:Key="DataWireTemplate" DataType="{x:Type domino:DominoConnectionViewModel}">
            <nodify:Connection Source="{Binding Source.Anchor}" Target="{Binding Target.Anchor}"
                               Stroke="{Binding Source, Converter={StaticResource PortBrush}}"
                               StrokeThickness="1.1" Direction="Forward" ArrowSize="5,5"
                               Text="{Binding Label}" FontSize="10" Foreground="#FFFFFF"
                               TextBackground="{Binding Source, Converter={StaticResource PortBrush}}"
                               TextCornerRadius="6" TextPadding="6,1" />
        </DataTemplate>

        <!-- Dashed: several handlers write the variable this value travels through, so the producer is
             one of these candidates rather than provably this one. -->
        <DataTemplate x:Key="AmbiguousDataWireTemplate" DataType="{x:Type domino:DominoConnectionViewModel}">
            <nodify:Connection Source="{Binding Source.Anchor}" Target="{Binding Target.Anchor}"
                               Stroke="#7A5A18" StrokeThickness="1.1" StrokeDashArray="3 3"
                               Direction="Forward" ArrowSize="5,5"
                               Text="{Binding Label}" FontSize="10" Foreground="#FFFFFF"
                               TextBackground="#7A5A18"
                               TextCornerRadius="6" TextPadding="6,1" />
        </DataTemplate>

        <!--
          One template, switching shape by trigger, rather than a ConnectionTemplateSelector:
          NodifyEditor.ConnectionTemplateSelector is declared but never actually consulted in Nodify
          7.3.0 (verified - the selector's SelectTemplate is not called even once), so setting it alone
          silently leaves every wire on the library's default template, drawn with unbound Source/Target
          at the origin. ConnectionTemplate is the path Nodify's own examples use and does work.
        -->
        <DataTemplate x:Key="WireTemplate" DataType="{x:Type domino:DominoConnectionViewModel}">
            <ContentControl Content="{Binding}" Opacity="{Binding Opacity}">
                <ContentControl.Style>
                    <Style TargetType="ContentControl">
                        <Setter Property="ContentTemplate" Value="{StaticResource ControlWireTemplate}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Kind}" Value="Data">
                                <Setter Property="ContentTemplate" Value="{StaticResource DataWireTemplate}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Ambiguous}" Value="True">
                                <Setter Property="ContentTemplate" Value="{StaticResource AmbiguousDataWireTemplate}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ContentControl.Style>
            </ContentControl>
        </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*" MinWidth="240" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="1*" MinWidth="260" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#F7F7F7" BorderBrush="#DDD" BorderThickness="0,0,1,0" ClipToBounds="True">
            <Grid>
                <nodify:NodifyEditor x:Name="Editor"
                                     ItemsSource="{Binding Nodes}"
                                     Connections="{Binding Connections}"
                                     SelectedItem="{Binding SelectedNode, Mode=TwoWay}"
                                     ConnectionTemplate="{StaticResource WireTemplate}"
                                     Background="Transparent"
                                     GridCellSize="16"
                                     DisplayConnectionsOnTop="False">
                    <nodify:NodifyEditor.ItemContainerStyle>
                        <Style TargetType="{x:Type nodify:ItemContainer}">
                            <Setter Property="Location" Value="{Binding Location, Mode=TwoWay}" />
                            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                            <Setter Property="Opacity" Value="{Binding Opacity}" />
                        </Style>
                    </nodify:NodifyEditor.ItemContainerStyle>

                    <nodify:NodifyEditor.ItemTemplate>
                        <DataTemplate DataType="{x:Type domino:DominoNodeViewModel}">
                            <nodify:Node Input="{Binding Input}"
                                         Output="{Binding Output}"
                                         InputConnectorTemplate="{StaticResource InputPortTemplate}"
                                         OutputConnectorTemplate="{StaticResource OutputPortTemplate}"
                                         MinWidth="{Binding Width}"
                                         ToolTip="{Binding Subtitle}"
                                         Background="{Binding Converter={StaticResource NodeBrush}}"
                                         HeaderBrush="{Binding Converter={StaticResource NodeBrush}}"
                                         ContentBrush="Transparent"
                                         BorderBrush="{Binding Converter={StaticResource NodeBrush}, ConverterParameter=border}"
                                         BorderThickness="1"
                                         Foreground="#141414">
                                <nodify:Node.Header>
                                    <StackPanel Margin="2,1">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Subtitle}" FontSize="9" Foreground="#777"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </nodify:Node.Header>
                            </nodify:Node>
                        </DataTemplate>
                    </nodify:NodifyEditor.ItemTemplate>
                </nodify:NodifyEditor>

                <!-- Status strip -->
                <Border Background="#E8FFFFFF" BorderBrush="#CCC" BorderThickness="1" CornerRadius="3"
                        HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8" Padding="8,4">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="StatusText" FontFamily="Consolas" FontSize="11"
                                   TextWrapping="Wrap" MaxWidth="560" VerticalAlignment="Center" />
                        <Button x:Name="FitButton" Content="Fit" Margin="12,0,0,0" Padding="8,2" Click="FitButton_Click" />

                        <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="10,2" />

                        <TextBlock Text="Focus" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <ComboBox x:Name="FocusSelector" Width="96" SelectedIndex="0"
                                  SelectionChanged="FocusSelector_SelectionChanged"
                                  ToolTip="Fade everything more than N steps from the selected box.">
                            <ComboBoxItem Content="off" />
                            <ComboBoxItem Content="1 hop" />
                            <ComboBoxItem Content="2 hops" />
                            <ComboBoxItem Content="3 hops" />
                            <ComboBoxItem Content="5 hops" />
                        </ComboBox>
                        <TextBlock x:Name="FocusStatus" FontSize="11" Foreground="#666"
                                   VerticalAlignment="Center" Margin="8,0,0,0" />
                    </StackPanel>
                </Border>

                <!-- Legend -->
                <Border Background="#E8FFFFFF" BorderBrush="#CCC" BorderThickness="1" CornerRadius="3"
                        HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="8" Padding="8,5">
                    <StackPanel>
                        <TextBlock Text="BOXES" FontSize="8" Foreground="#888" FontWeight="SemiBold" Margin="0,0,0,3" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                            <Border Width="10" Height="10" Background="#E8F0FE" BorderBrush="#9AA6B8" BorderThickness="1" />
                            <TextBlock Text="persistent" FontSize="9" Margin="4,0,10,0" />
                            <Border Width="10" Height="10" Background="#FCF3E3" BorderBrush="#C6A87A" BorderThickness="1" />
                            <TextBlock Text="pooled" FontSize="9" Margin="4,0,10,0" />
                            <Border Width="10" Height="10" Background="#E6F7E9" BorderBrush="#8FBF98" BorderThickness="1" />
                            <TextBlock Text="sub-graph" FontSize="9" Margin="4,0,10,0" />
                            <Border Width="10" Height="10" Background="#EFEFEF" BorderBrush="#AAA" BorderThickness="1" />
                            <TextBlock Text="graph boundary" FontSize="9" Margin="4,0,0,0" />
                        </StackPanel>
                        <TextBlock Text="WIRES" FontSize="8" Foreground="#888" FontWeight="SemiBold" Margin="0,4,0,3" />
                        <StackPanel Orientation="Horizontal">
                            <Rectangle Width="14" Height="2" Fill="#5A6472" VerticalAlignment="Center" />
                            <TextBlock Text="control" FontSize="9" Margin="4,0,10,0" />
                            <Rectangle Width="14" Height="2" Fill="#2E7D32" VerticalAlignment="Center" />
                            <TextBlock Text="data (colored by type)" FontSize="9" Margin="4,0,10,0" />
                            <Rectangle Width="14" Height="2" Fill="#B08A3C" VerticalAlignment="Center" />
                            <TextBlock Text="ambiguous producer" FontSize="9" Margin="4,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <nodify:Minimap HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8"
                                Width="190" Height="130"
                                Background="#DDFFFFFF" BorderBrush="#CCC" BorderThickness="1"
                                ItemsSource="{Binding Nodes}"
                                ViewportLocation="{Binding ElementName=Editor, Path=ViewportLocation, Mode=TwoWay}"
                                ViewportSize="{Binding ElementName=Editor, Path=ViewportSize}">
                    <nodify:Minimap.ItemContainerStyle>
                        <Style TargetType="{x:Type nodify:MinimapItem}">
                            <Setter Property="Location" Value="{Binding Location}" />
                            <Setter Property="Background" Value="{Binding Converter={StaticResource NodeBrush}, ConverterParameter=border}" />
                        </Style>
                    </nodify:Minimap.ItemContainerStyle>
                </nodify:Minimap>
            </Grid>
        </Border>

        <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" Background="#DDD" />

        <TabControl Grid.Column="2">
            <TabItem Header="Inspector">
                <domino:DominoInspector x:Name="Inspector" />
            </TabItem>
            <TabItem Header="Lua source">
                <text:TextFileHandler x:Name="SourceView" Extension="lua" />
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
