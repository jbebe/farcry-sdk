<UserControl x:Class="JackAll.App.Domino.DominoInspector"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="9" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#888" />
            <Setter Property="Margin" Value="0,12,0,4" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="#666" />
        </Style>
        <Style x:Key="FieldValue" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10,8">
        <StackPanel x:Name="Root">
            <TextBlock x:Name="EmptyNotice"
                       Text="Select a box on the canvas to inspect it."
                       FontSize="11" Foreground="#888" TextWrapping="Wrap" Margin="0,4" />

            <StackPanel x:Name="Details" Visibility="Collapsed">
                <TextBlock x:Name="NodeTitle" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock x:Name="NodeCategory" Style="{StaticResource FieldLabel}" Margin="0,1,0,0" />

                <TextBlock Text="TYPE" Style="{StaticResource SectionHeader}" />
                <TextBlock x:Name="NodeTypePath" Style="{StaticResource FieldValue}" />
                <TextBlock x:Name="NodeInstance" Style="{StaticResource FieldValue}" Foreground="#666" />
                <TextBlock x:Name="SignatureNotice" Style="{StaticResource FieldValue}" Foreground="#A06000"
                           Visibility="Collapsed" />

                <TextBlock x:Name="ParamsHeader" Text="PARAMETERS" Style="{StaticResource SectionHeader}" />
                <ItemsControl x:Name="ParamList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" MinWidth="110" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Name}" FontSize="10" Foreground="#555" Margin="0,0,8,0" />
                                <TextBlock Grid.Column="1" Text="{Binding Value}" FontFamily="Consolas" FontSize="11"
                                           TextWrapping="Wrap" ToolTip="{Binding Value}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock x:Name="PinsHeader" Text="PINS" Style="{StaticResource SectionHeader}" />
                <ItemsControl x:Name="PinList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" MinWidth="52" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Direction}" FontSize="9" Foreground="#999" />
                                <TextBlock Grid.Column="1" Text="{Binding Name}" FontFamily="Consolas" FontSize="11"
                                           TextWrapping="Wrap" />
                                <TextBlock Grid.Column="2" Text="{Binding Detail}" FontSize="9" Foreground="#888"
                                           Margin="6,0,0,0" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <TextBlock Text="GRAPH" Style="{StaticResource SectionHeader}" />
            <TextBlock x:Name="GraphSummary" Style="{StaticResource FieldValue}" Foreground="#555" />

            <TextBlock x:Name="DepsHeader" Text="REGISTERED NODE TYPES" Style="{StaticResource SectionHeader}"
                       Visibility="Collapsed" />
            <ItemsControl x:Name="DepList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="10" Foreground="#555"
                                   TextWrapping="Wrap" Margin="0,0,0,2" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock x:Name="ResourcesHeader" Text="LOADED RESOURCES" Style="{StaticResource SectionHeader}"
                       Visibility="Collapsed" />
            <ItemsControl x:Name="ResourceList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="10" Foreground="#555"
                                   TextWrapping="Wrap" Margin="0,0,0,2" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
