<UserControl x:Class="JackAll.App.Library.LibraryTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:library="clr-namespace:JackAll.App.Library">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- Grey = only one library declares this, so an edit to it is live. Red = a later library
             declares it too, so every copy but the last is dead. -->
        <HierarchicalDataTemplate x:Key="ArchetypeTemplate" DataType="{x:Type library:ArchetypeTreeNode}"
                                  ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Label}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#333" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ContainsShadowed}" Value="True">
                                    <Setter Property="Foreground" Value="#B00" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsShadowed}" Value="True">
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="{Binding Chain}" Margin="8,0,0,0" FontSize="10.5" Foreground="#888"
                           VerticalAlignment="Center" />
            </StackPanel>
        </HierarchicalDataTemplate>

        <!-- One layer in the selected archetype's chain. The last row wins; the rest are what an edit
             would silently miss. -->
        <DataTemplate x:Key="ChainRowTemplate" DataType="{x:Type library:ChainRow}">
            <Border Padding="7,5" Margin="0,0,0,3" BorderThickness="1" CornerRadius="2">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="#FAFAFA" />
                        <Setter Property="BorderBrush" Value="#DDD" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Wins}" Value="True">
                                <Setter Property="Background" Value="#EAF6EA" />
                                <Setter Property="BorderBrush" Value="#A8D2A8" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding Verdict}" FontSize="10.5"
                                   VerticalAlignment="Center" Margin="6,0,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#B00" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Wins}" Value="True">
                                            <Setter Property="Foreground" Value="#2A7A2A" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding ShortName}" FontWeight="SemiBold" FontSize="11.5" />
                    </DockPanel>
                    <TextBlock Text="{Binding Path}" FontSize="10.5" Foreground="#777" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding FragmentId}" FontSize="10.5" Foreground="#999" />
                    <TextBlock Text="Load order for this layer is not confirmed in Dunia.dll" FontSize="10"
                               Foreground="#96701E" TextWrapping="Wrap" Margin="0,2,0,0"
                               Visibility="{Binding IsUnconfirmed, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <DockPanel Margin="6">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8" LastChildFill="False">
            <TextBlock Text="World:" VerticalAlignment="Center" Margin="0,0,6,0" />
            <ComboBox x:Name="WorldPicker" Width="150" VerticalAlignment="Center" IsEnabled="False" />
            <TextBlock Text="Reads as:" VerticalAlignment="Center" Margin="16,0,6,0" />
            <ComboBox x:Name="ProfilePicker" Width="180" VerticalAlignment="Center"
                      SelectedIndex="0" ToolTip="Which binary's library load order to resolve against.">
                <ComboBoxItem Content="Campaign client (_full)" />
                <ComboBoxItem Content="Dedicated server (base)" />
            </ComboBox>
            <Button x:Name="LoadButton" Content="Load" Padding="10,5" Margin="16,0,0,0"
                    IsEnabled="False" Click="Load_Click" />
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Margin="16,0,0,0" Foreground="#666"
                       Text="Pick a world and Load" />
        </DockPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" MinWidth="220" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="*" MinWidth="360" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="260" MinWidth="180" />
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                    <CheckBox x:Name="ShadowedOnly" DockPanel.Dock="Right" Content="Overridden only"
                              VerticalAlignment="Center" Margin="6,0,0,0" Click="Filter_Changed" />
                    <TextBox x:Name="SearchBox" Padding="4,2" TextChanged="Filter_Changed" />
                </DockPanel>

                <TreeView x:Name="ArchetypeTree" ItemTemplate="{StaticResource ArchetypeTemplate}"
                          BorderBrush="#CCC" BorderThickness="1"
                          VirtualizingStackPanel.IsVirtualizing="True"
                          VirtualizingStackPanel.VirtualizationMode="Recycling"
                          ScrollViewer.CanContentScroll="True"
                          SelectedItemChanged="ArchetypeTree_SelectedItemChanged">
                    <!-- Declared here rather than as ItemContainerStyle so it applies at every depth. -->
                    <TreeView.Resources>
                        <Style TargetType="TreeViewItem">
                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsVisible}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TreeView.Resources>
                </TreeView>
            </DockPanel>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" Background="Transparent" />

            <Border Grid.Column="2" BorderBrush="#CCC" BorderThickness="1">
                <Grid>
                    <TextBlock x:Name="EditorPlaceholder" Margin="14" Foreground="#888" TextWrapping="Wrap"
                               Text="Select an archetype to edit the definition the game actually reads." />
                    <ContentControl x:Name="EditorHost" />
                </Grid>
            </Border>

            <GridSplitter Grid.Column="3" Width="4" HorizontalAlignment="Stretch" Background="Transparent" />

            <DockPanel Grid.Column="4">
                <TextBlock DockPanel.Dock="Top" Text="Override chain" FontWeight="SemiBold" Margin="0,0,0,6" />
                <TextBlock x:Name="ChainHint" DockPanel.Dock="Bottom" FontSize="10.5" Foreground="#888"
                           TextWrapping="Wrap" Margin="0,6,0,0"
                           Text="Click a layer to inspect its own copy." />
                <ListBox x:Name="ChainList" ItemTemplate="{StaticResource ChainRowTemplate}"
                         BorderThickness="0" HorizontalContentAlignment="Stretch"
                         SelectionChanged="ChainList_SelectionChanged" />
            </DockPanel>
        </Grid>
    </DockPanel>
</UserControl>
