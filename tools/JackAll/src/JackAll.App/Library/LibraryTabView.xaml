<UserControl x:Class="JackAll.App.Library.LibraryTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:library="clr-namespace:JackAll.App.Library">
    <UserControl.Resources>
        <!-- Highlighted = an enabled mod edits this archetype, or something inside this group. -->
        <HierarchicalDataTemplate x:Key="ArchetypeTemplate" DataType="{x:Type library:ArchetypeTreeNode}"
                                  ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Label}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ContainsModded}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource OkTextBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsModded}" Value="True">
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="{Binding Mods}" Margin="8,0,0,0" Style="{StaticResource Caption}"
                           VerticalAlignment="Center" />
            </StackPanel>
        </HierarchicalDataTemplate>

        <!-- One mod editing the selected archetype. Dead = it edits a copy the game doesn't read. -->
        <DataTemplate x:Key="ModRowTemplate" DataType="{x:Type library:ModRow}">
            <Border Padding="7,5" Margin="0,0,0,3">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource PreviewFrame}">
                        <Setter Property="CornerRadius" Value="{StaticResource CalloutRadius}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsLive}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource OkBgBrush}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource OkBorderBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding Verdict}" FontSize="{StaticResource FontSizeSmall}"
                                   VerticalAlignment="Center" Margin="6,0,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsLive}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource OkTextBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding Mod}" FontWeight="SemiBold" FontSize="{StaticResource FontSizeSecondary}" />
                    </DockPanel>
                    <TextBlock Text="{Binding Path}" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <DockPanel>
        <DockPanel DockPanel.Dock="Top" Style="{StaticResource TabToolbar}" LastChildFill="False">
            <TextBlock x:Name="StatusText" Style="{StaticResource StatusText}" Text="Pick a world and Load" />
            <TextBlock Text="World:" Style="{StaticResource ToolbarLabel}" />
            <ComboBox x:Name="WorldPicker" Width="150" VerticalAlignment="Center" IsEnabled="False" />
            <Button x:Name="LoadButton" Content="Load" Margin="16,0,0,0"
                    VerticalAlignment="Center" IsEnabled="False" Click="Load_Click" />
        </DockPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" MinWidth="220" />
                <ColumnDefinition Width="{StaticResource SplitterSize}" />
                <ColumnDefinition Width="*" MinWidth="360" />
                <ColumnDefinition Width="{StaticResource SplitterSize}" />
                <ColumnDefinition Width="260" MinWidth="180" />
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                    <CheckBox x:Name="ModdedOnly" DockPanel.Dock="Right" Content="Modded only"
                              VerticalAlignment="Center" Margin="6,0,0,0" Click="Filter_Changed" />
                    <TextBox x:Name="SearchBox" Style="{StaticResource SearchBox}" TextChanged="Filter_Changed" />
                </DockPanel>

                <TreeView x:Name="ArchetypeTree" ItemTemplate="{StaticResource ArchetypeTemplate}"
                          BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1"
                          VirtualizingStackPanel.IsVirtualizing="True"
                          VirtualizingStackPanel.VirtualizationMode="Recycling"
                          ScrollViewer.CanContentScroll="True"
                          ItemContainerStyle="{StaticResource BoundTreeItem}"
                          SelectedItemChanged="ArchetypeTree_SelectedItemChanged" />
            </DockPanel>

            <GridSplitter Grid.Column="1" />

            <Border Grid.Column="2" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1">
                <Grid>
                    <TextBlock x:Name="EditorPlaceholder" Margin="14" Style="{StaticResource EmptyHint}"
                               Text="Select an archetype to edit the definition the game reads." />
                    <ContentControl x:Name="EditorHost" />
                </Grid>
            </Border>

            <GridSplitter Grid.Column="3" />

            <DockPanel Grid.Column="4">
                <TextBlock DockPanel.Dock="Top" Text="Mods editing this" FontWeight="SemiBold" Margin="0,0,0,6" />
                <TextBlock x:Name="ModHint" DockPanel.Dock="Bottom" Style="{StaticResource Caption}"
                           TextWrapping="Wrap" Margin="0,6,0,0" />
                <ListBox x:Name="ModList" ItemTemplate="{StaticResource ModRowTemplate}"
                         BorderThickness="0" HorizontalContentAlignment="Stretch"
                         SelectionChanged="ModList_SelectionChanged" />
            </DockPanel>
        </Grid>
    </DockPanel>
</UserControl>
