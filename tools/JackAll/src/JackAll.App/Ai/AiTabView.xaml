<UserControl x:Class="JackAll.App.Ai.AiTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ai="clr-namespace:JackAll.App.Ai"
             xmlns:tools="clr-namespace:JackAll.Tools.Ai;assembly=JackAll.Tools">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Visible" />

        <Style x:Key="PanelTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Bold where a value differs from the base game. -->
        <Style x:Key="ChangedRow" TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsChanged}" Value="True">
                    <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <HierarchicalDataTemplate DataType="{x:Type ai:BrainTreeItem}" ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Label}" />
                <TextBlock Text="{Binding Detail}" Margin="8,0,0,0" Style="{StaticResource Caption}" VerticalAlignment="Center" />
            </StackPanel>
        </HierarchicalDataTemplate>

        <DataTemplate x:Key="LinkTemplate" DataType="{x:Type ai:BrainLinkRow}">
            <TextBlock Text="{Binding Text}" Foreground="{DynamicResource LinkBrush}" Cursor="Hand" TextTrimming="CharacterEllipsis" />
        </DataTemplate>
    </UserControl.Resources>

    <DockPanel>
        <DockPanel DockPanel.Dock="Top" Style="{StaticResource TabToolbar}" LastChildFill="False">
            <TextBlock Style="{StaticResource StatusText}" Text="{Binding Status}" />
            <Button Content="Save" Margin="20,0,0,0" VerticalAlignment="Center" Style="{StaticResource PrimaryButton}"
                    IsEnabled="{Binding CanSave}" Click="Save_Click" AutomationProperties.AutomationId="AiSaveButton"
                    ToolTip="Stage every edit on this tab into the workspace; Build then puts it in the game." />
            <Button Content="Revert" Margin="8,0,0,0" VerticalAlignment="Center" IsEnabled="{Binding IsDirty}"
                    Click="Revert_Click" AutomationProperties.AutomationId="AiRevertButton"
                    ToolTip="Throw away the edits made since the last save." />
        </DockPanel>

        <TabControl x:Name="Sections" SelectionChanged="Sections_SelectionChanged" AutomationProperties.AutomationId="AiSections">
            <!-- ============================ SOLDIERS ============================ -->
            <TabItem Header="Soldiers" x:Name="SoldiersSection">
                <ai:ArchetypeTuningView DataContext="{Binding Soldiers}" />
            </TabItem>

            <!-- ============================ WEAPONS ============================= -->
            <TabItem Header="Weapons" x:Name="WeaponsSection">
                <ai:ArchetypeTuningView DataContext="{Binding Weapons}" />
            </TabItem>

            <!-- ============================= CURVES ============================= -->
            <TabItem Header="Curves" x:Name="CurvesSection">
                <Grid Margin="0,6,0,0" IsEnabled="{Binding Curves.IsLoaded}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="320" MinWidth="220" />
                        <ColumnDefinition Width="{StaticResource SplitterSize}" />
                        <ColumnDefinition Width="*" MinWidth="420" />
                    </Grid.ColumnDefinitions>

                    <DockPanel Grid.Column="0">
                        <TextBlock DockPanel.Dock="Top" Text="Curves" Style="{StaticResource PanelTitle}" />
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource Note}" Margin="0,2,0,8"
                                   Text="The curves weapon properties name. DistanceAccuracy_* is a weapon's hit-chance factor against distance in metres; GroupNumber the factor against how many soldiers already shoot at the same target." />
                        <TextBox DockPanel.Dock="Top" Style="{StaticResource SearchBox}" Margin="0,0,0,6" Tag="Filter by name"
                                 Text="{Binding Curves.Filter, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.AutomationId="AiCurveFilter" />
                        <ListBox ItemsSource="{Binding Curves.Visible}" SelectedItem="{Binding Curves.Selected}"
                                 AutomationProperties.AutomationId="AiCurveList">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type ai:TunedArchetype}">
                                    <TextBlock Text="{Binding Label}" ToolTip="{Binding Name}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsEdited}" Value="True">
                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                        <Setter Property="Foreground" Value="{DynamicResource OkTextBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>

                    <GridSplitter Grid.Column="1" />

                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="220" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Style="{StaticResource Note}" Margin="0,0,0,6"
                                   Text="Knots are joined by straight lines and the curve holds its end values outside them. The dashed line is the base game. Edit the numbers below; each edit goes to both worlds' copies." />
                        <Border Grid.Row="1" Style="{StaticResource InertFrame}" Margin="0,0,0,8">
                            <Canvas x:Name="CurveChart" ClipToBounds="True" SizeChanged="CurveChart_SizeChanged"
                                    AutomationProperties.AutomationId="AiCurveChart" />
                        </Border>
                        <DataGrid Grid.Row="2" ItemsSource="{Binding Curves.Rows}" AutoGenerateColumns="False"
                                  CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="False"
                                  HeadersVisibility="Column" RowStyle="{StaticResource ChangedRow}"
                                  AutomationProperties.AutomationId="AiCurvePoints">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="#" Binding="{Binding Index}" Width="40" IsReadOnly="True" ElementStyle="{StaticResource Muted}" />
                                <DataGridTemplateColumn Header="Input" Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate DataType="{x:Type ai:CurvePointRow}">
                                            <TextBox Text="{Binding X, UpdateSourceTrigger=LostFocus}" KeyDown="ValueBox_KeyDown" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Value" Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate DataType="{x:Type ai:CurvePointRow}">
                                            <TextBox Text="{Binding Y, UpdateSourceTrigger=LostFocus}" KeyDown="ValueBox_KeyDown" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Base game" Binding="{Binding Vanilla}" Width="*" IsReadOnly="True"
                                                    ElementStyle="{StaticResource Muted}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ========================= BEHAVIOUR ODDS ========================= -->
            <TabItem Header="Behaviour odds" x:Name="BehaviorsSection">
                <DockPanel Margin="0,6,0,0" IsEnabled="{Binding Behaviors.IsLoaded}">
                    <TextBlock DockPanel.Dock="Top" Text="How often each optional behaviour happens" Style="{StaticResource PanelTitle}" />
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Note}" Margin="0,2,0,8"
                               Text="Chance in percent that a soldier uses the behaviour when the situation arises, by progression level 0-27 - the same scale the enemy weapon packs use, rising as the campaign goes on. Hover a behaviour for what it gates; bold cells differ from the base game." />
                    <Border DockPanel.Dock="Bottom" Style="{StaticResource InertFrame}" Padding="8" Margin="0,8,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Set" Style="{StaticResource ToolbarLabel}" />
                            <ComboBox x:Name="FillBehavior" Width="200" Margin="6,0" ItemsSource="{Binding Behaviors.Rows}" DisplayMemberPath="Name" />
                            <TextBlock Text="from level" Style="{StaticResource ToolbarLabel}" />
                            <TextBox x:Name="FillFrom" Width="40" Margin="6,0" Text="0" />
                            <TextBlock Text="onwards to" Style="{StaticResource ToolbarLabel}" />
                            <TextBox x:Name="FillValue" Width="50" Margin="6,0" Text="100" />
                            <TextBlock Text="%" Style="{StaticResource ToolbarLabel}" />
                            <Button Content="Fill" Style="{StaticResource DenseButton}" Margin="10,0,0,0" Click="Fill_Click" />
                        </StackPanel>
                    </Border>
                    <DataGrid x:Name="BehaviorGrid" ItemsSource="{Binding Behaviors.Rows}" AutoGenerateColumns="False"
                              CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="False"
                              HeadersVisibility="Column" SelectionUnit="Cell" FrozenColumnCount="1"
                              AutomationProperties.AutomationId="AiBehaviorGrid">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Behaviour" Width="190" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type ai:BehaviorRow}">
                                        <TextBlock Text="{Binding Name}" ToolTip="{Binding Description}" VerticalAlignment="Center" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- ============================= BRAINS ============================= -->
            <TabItem Header="Brains" x:Name="BrainsSection">
                <DockPanel Margin="0,6,0,0">
                    <DockPanel DockPanel.Dock="Top" LastChildFill="False" Margin="0,0,0,6">
                        <TextBlock Text="Brain:" Style="{StaticResource ToolbarLabel}" />
                        <ComboBox x:Name="BrainPicker" Width="360" Margin="6,0,0,0" ItemsSource="{Binding Brains.Brains}"
                                  SelectionChanged="BrainPicker_SelectionChanged" AutomationProperties.AutomationId="AiBrainPicker" />
                        <TextBlock Style="{StaticResource Note}" Margin="12,0,0,0" VerticalAlignment="Center"
                                   Text="mercbrain drives every soldier. Parameters edit in place; Save recompiles the brain." />
                    </DockPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="420" MinWidth="260" />
                            <ColumnDefinition Width="{StaticResource SplitterSize}" />
                            <ColumnDefinition Width="*" MinWidth="420" />
                        </Grid.ColumnDefinitions>

                        <DockPanel Grid.Column="0">
                            <TextBox DockPanel.Dock="Top" Style="{StaticResource SearchBox}" Margin="0,0,0,6"
                                     Tag="Find a node by name or class, e.g. Grenade CTaskShoot"
                                     Text="{Binding Brains.Search, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.AutomationId="AiBrainSearch" />
                            <Grid>
                                <TreeView x:Name="BrainTree" ItemsSource="{Binding Brains.Tree}"
                                          SelectedItemChanged="BrainTree_SelectedItemChanged"
                                          VirtualizingPanel.IsVirtualizing="True"
                                          AutomationProperties.AutomationId="AiBrainTree">
                                    <TreeView.ItemContainerStyle>
                                        <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                        </Style>
                                    </TreeView.ItemContainerStyle>
                                </TreeView>
                                <ListBox x:Name="SearchList" ItemsSource="{Binding Brains.SearchResults}"
                                         SelectionChanged="SearchList_SelectionChanged"
                                         AutomationProperties.AutomationId="AiBrainSearchResults">
                                    <ListBox.Style>
                                        <Style TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Brains.Search}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ListBox.Style>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate DataType="{x:Type tools:AiNode}">
                                            <StackPanel>
                                                <TextBlock Text="{Binding ShortName}" />
                                                <TextBlock Text="{Binding Name}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </DockPanel>

                        <GridSplitter Grid.Column="1" />

                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="2*" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Margin="0,0,0,8">
                                <TextBlock Text="{Binding Brains.Heading}" Style="{StaticResource Heading}" />
                                <TextBlock Text="{Binding Brains.Summary}" Style="{StaticResource Note}" TextWrapping="Wrap" />
                            </StackPanel>
                            <DataGrid Grid.Row="1" ItemsSource="{Binding Brains.Parameters}" AutoGenerateColumns="False"
                                      CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column"
                                      RowStyle="{StaticResource ChangedRow}" AutomationProperties.AutomationId="AiBrainParameters">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Parameter" Binding="{Binding Name}" Width="240" IsReadOnly="True" />
                                    <DataGridTemplateColumn Header="Value" Width="*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate DataType="{x:Type ai:BrainParameterRow}">
                                                <TextBox Text="{Binding Value, UpdateSourceTrigger=LostFocus}" KeyDown="ValueBox_KeyDown" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Base game" Binding="{Binding Vanilla}" Width="*" IsReadOnly="True"
                                                        ElementStyle="{StaticResource Muted}" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock Grid.Row="2" Text="Wiring - click to go there" Style="{StaticResource SectionHeader}" Margin="0,10,0,4" />
                            <Grid Grid.Row="3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ListBox Grid.Column="0" ItemsSource="{Binding Brains.Links}" ItemTemplate="{StaticResource LinkTemplate}"
                                         SelectionChanged="Link_SelectionChanged" AutomationProperties.AutomationId="AiBrainLinks" />
                                <DockPanel Grid.Column="2">
                                    <TextBlock DockPanel.Dock="Top" Text="Used by" Style="{StaticResource Caption}" Margin="0,0,0,2" />
                                    <ListBox ItemsSource="{Binding Brains.UsedBy}" ItemTemplate="{StaticResource LinkTemplate}"
                                             SelectionChanged="Link_SelectionChanged" AutomationProperties.AutomationId="AiBrainUsedBy" />
                                </DockPanel>
                            </Grid>
                        </Grid>
                    </Grid>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</UserControl>
