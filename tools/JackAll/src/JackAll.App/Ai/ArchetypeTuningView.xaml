<UserControl x:Class="JackAll.App.Ai.ArchetypeTuningView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ai="clr-namespace:JackAll.App.Ai">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Visible" />

        <Style x:Key="PanelTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <CollectionViewSource x:Key="ArchetypeView" Source="{Binding Visible}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="Group" />
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>

        <CollectionViewSource x:Key="FieldView" Source="{Binding Rows}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="Group" />
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>
    </UserControl.Resources>

    <Grid Margin="0,6,0,0" IsEnabled="{Binding IsLoaded}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" MinWidth="220" />
            <ColumnDefinition Width="{StaticResource SplitterSize}" />
            <ColumnDefinition Width="*" MinWidth="420" />
        </Grid.ColumnDefinitions>

        <DockPanel Grid.Column="0">
            <TextBlock DockPanel.Dock="Top" Text="Archetypes" Style="{StaticResource PanelTitle}" />
            <TextBlock DockPanel.Dock="Top" Style="{StaticResource Note}" Margin="0,2,0,8" Text="{Binding ListNote}" />
            <TextBox DockPanel.Dock="Top" Style="{StaticResource SearchBox}" Margin="0,0,0,6" Tag="Filter by name"
                     Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}"
                     AutomationProperties.AutomationId="AiArchetypeFilter" />
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                <Button Content="Tick shown" Style="{StaticResource DenseButton}" Click="SelectShown_Click" />
                <Button Content="Clear" Style="{StaticResource DenseButton}" Margin="6,0,0,0" Click="SelectNone_Click" />
            </StackPanel>
            <ListBox ItemsSource="{Binding Source={StaticResource ArchetypeView}}" AutomationProperties.AutomationId="AiArchetypeList"
                     VirtualizingPanel.IsVirtualizingWhenGrouping="True">
                <ListBox.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" Style="{StaticResource SectionHeader}" Margin="4,10,0,2" />
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </ListBox.GroupStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type ai:TunedArchetype}">
                        <CheckBox IsChecked="{Binding IsSelected}" ToolTip="{Binding Name}">
                            <TextBlock Text="{Binding Label}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsEdited}" Value="True">
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                                <Setter Property="Foreground" Value="{DynamicResource OkTextBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </CheckBox>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <GridSplitter Grid.Column="1" />

        <DockPanel Grid.Column="2">
            <TextBlock DockPanel.Dock="Top" Text="{Binding SelectionSummary}" Style="{StaticResource PanelTitle}" />
            <TextBlock DockPanel.Dock="Top" Style="{StaticResource Note}" Margin="0,2,0,8" Text="{Binding FieldNote}" />
            <DataGrid ItemsSource="{Binding Source={StaticResource FieldView}}" AutoGenerateColumns="False"
                      CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="False"
                      HeadersVisibility="Column" RowStyle="{StaticResource ChangedRow}"
                      VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                      AutomationProperties.AutomationId="AiTuningFields">
                <DataGrid.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" Style="{StaticResource SectionHeader}" Margin="4,12,0,4" />
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </DataGrid.GroupStyle>
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Setting" Width="260" IsReadOnly="True">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="{x:Type ai:TuningFieldRow}">
                                <TextBlock Text="{Binding Label}" ToolTip="{Binding Help}" VerticalAlignment="Center" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Value" Width="150">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="{x:Type ai:TuningFieldRow}">
                                <Grid>
                                    <TextBox Text="{Binding Text, UpdateSourceTrigger=LostFocus}" ToolTip="{Binding Help}"
                                             Visibility="{Binding IsNumber, Converter={StaticResource Visible}}"
                                             KeyDown="ValueBox_KeyDown" />
                                    <ComboBox ItemsSource="{Binding Choices}" SelectedItem="{Binding Choice, UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding Help}">
                                        <ComboBox.Style>
                                            <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsNumber}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ComboBox.Style>
                                    </ComboBox>
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Base game" Binding="{Binding Vanilla}" Width="100" IsReadOnly="True"
                                        ElementStyle="{StaticResource Muted}" />
                    <DataGridTemplateColumn Header="What it does" Width="*" IsReadOnly="True">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="{x:Type ai:TuningFieldRow}">
                                <TextBlock Text="{Binding Help}" ToolTip="{Binding Help}" Style="{StaticResource Caption}"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
    </Grid>
</UserControl>
