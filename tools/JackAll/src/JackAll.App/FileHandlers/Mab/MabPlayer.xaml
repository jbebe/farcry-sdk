<UserControl x:Class="JackAll.App.FileHandlers.Mab.MabPlayer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <TextBlock x:Name="StatusText" DockPanel.Dock="Top" Style="{StaticResource Mono}" TextWrapping="Wrap" />

        <StackPanel x:Name="Toolbar" DockPanel.Dock="Top" Margin="0,8,0,0" Visibility="Collapsed">
            <DockPanel>
                <ToggleButton x:Name="PlayToggle" DockPanel.Dock="Left" Width="32" Content="▶" ToolTip="Play or pause"
                              Checked="PlayToggle_Changed" Unchecked="PlayToggle_Changed" />
                <Button DockPanel.Dock="Right" Content="Reset view" Style="{StaticResource DenseButton}" Click="ResetViewButton_Click" />
                <TextBlock x:Name="FrameText" Style="{StaticResource ToolbarLabel}" Margin="12,0" />
            </DockPanel>
            <Slider x:Name="FrameSlider" Margin="0,8,0,0" ValueChanged="FrameSlider_ValueChanged" />
        </StackPanel>

        <!-- Fills what the host leaves; the minimum keeps it open inside a stacked column. -->
        <Border x:Name="Frame" Margin="0,8,0,0" MinHeight="180" Style="{StaticResource PreviewFrame}"
                Background="{DynamicResource WellBrush}" Visibility="Collapsed">
            <Viewport3D x:Name="Viewport" ClipToBounds="True">
                <Viewport3D.Camera>
                    <PerspectiveCamera FieldOfView="45" />
                </Viewport3D.Camera>
            </Viewport3D>
        </Border>
    </DockPanel>
</UserControl>
