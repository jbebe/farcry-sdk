<UserControl x:Class="JackAll.App.FileHandlers.Text.TextFileHandler"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:avalonEdit="http://icsharpcode.net/sharpdevelop/avalonedit">
    <DockPanel>
        <Border x:Name="DiffBanner" DockPanel.Dock="Top" Visibility="Collapsed" Style="{StaticResource WarningCallout}"
                Margin="0,0,0,4">
            <TextBlock x:Name="DiffBannerText" TextWrapping="Wrap"
                       Text="Showing only the changed lines plus a little context - Export… gets the whole file." />
        </Border>
        <!-- Highlighting is set from code: it depends on the theme as well as on Extension. -->
        <avalonEdit:TextEditor x:Name="Editor" IsReadOnly="True" ShowLineNumbers="True" WordWrap="False"
                                Background="{DynamicResource SurfaceAltBrush}" />
    </DockPanel>
</UserControl>
