<UserControl x:Class="JackAll.App.FileHandlers.LauncherPreviewHandler"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:text="clr-namespace:JackAll.App.FileHandlers.Text">
    <DockPanel Margin="16">
        <TextBlock x:Name="Blurb" DockPanel.Dock="Top" TextWrapping="Wrap" Foreground="#666" Margin="0,0,0,12" />
        <Button x:Name="OpenButton" DockPanel.Dock="Top" Click="OpenEditor_Click"
                Padding="10,6" HorizontalAlignment="Left" Margin="0,0,0,16" />

        <TextBlock x:Name="PreviewUnavailableNotice" DockPanel.Dock="Top" TextWrapping="Wrap" Foreground="#888"
                   FontStyle="Italic" Visibility="Collapsed" />

        <Border x:Name="PreviewBorder" Background="#FAFAFA" BorderBrush="#DDD" BorderThickness="1">
            <text:TextFileHandler x:Name="Preview" />
        </Border>
    </DockPanel>
</UserControl>
