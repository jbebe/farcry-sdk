<UserControl x:Class="JackAll.App.FileHandlers.Spk.SpkFileHandler"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:audio="clr-namespace:JackAll.App.FileHandlers.Audio">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>
    <DockPanel Margin="16">
        <Border x:Name="AudioPanel" DockPanel.Dock="Bottom" Margin="0,16,0,0" Style="{StaticResource InertFrame}"
                Padding="12" Visibility="Collapsed">
            <StackPanel>
                <TextBlock Text="Audio preview" FontWeight="Bold" Margin="0,0,0,8" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <Button x:Name="ExportAudioButton" Content="Export as .wav…" Click="ExportAudio_Click"
                            Margin="0,0,8,0" IsEnabled="False" />
                    <Button x:Name="ImportAudioButton" Content="Import…" Click="ImportAudio_Click"
                            IsEnabled="False" />
                </StackPanel>
                <audio:AudioPreviewPanel x:Name="AudioPreview" />
                <TextBlock x:Name="AudioStatusText" Margin="0,8,0,0" Style="{StaticResource MonoSmall}"
                           TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" />
            </StackPanel>
        </Border>

        <TextBlock x:Name="HeaderText" DockPanel.Dock="Top" FontWeight="Bold" Margin="0,0,0,8" />

        <CheckBox x:Name="ShowRawDetailsCheckBox" DockPanel.Dock="Top" Content="Show raw technical details"
                  Margin="0,0,0,8" Checked="ShowRawDetailsCheckBox_Changed" Unchecked="ShowRawDetailsCheckBox_Changed" />

        <DockPanel LastChildFill="True">
            <Border x:Name="RawDetailsPanel" DockPanel.Dock="Bottom" Margin="0,8,0,0" Style="{StaticResource PreviewFrame}"
                    Padding="10" MaxHeight="220" Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="RawDetailsText" Style="{StaticResource MonoSmall}" TextWrapping="Wrap" />
                </ScrollViewer>
            </Border>

            <DataGrid x:Name="RecordsGrid" CanUserReorderColumns="False"
                      SelectionMode="Single" SelectionChanged="RecordsGrid_SelectionChanged">
                <DataGrid.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" FontWeight="Bold" Margin="0,12,0,4" />
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </DataGrid.GroupStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="#" Binding="{Binding IndexLabel}" Width="40" />
                    <DataGridTextColumn Header="Id" Binding="{Binding IdHex}" Width="110">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Mono}" />
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Kind" Binding="{Binding Kind}" Width="120" />
                    <DataGridTextColumn Header="Summary" Binding="{Binding Summary}" Width="*" />
                    <DataGridTemplateColumn Header="" Width="90">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="{Binding LinkButtonText}" Click="GoToLink_Click"
                                        IsEnabled="{Binding CanNavigateLink}"
                                        Visibility="{Binding ShowLinkButton, Converter={StaticResource BoolToVis}}"
                                        Style="{StaticResource DenseButton}" FontSize="{StaticResource FontSizeSecondary}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
    </DockPanel>
</UserControl>
