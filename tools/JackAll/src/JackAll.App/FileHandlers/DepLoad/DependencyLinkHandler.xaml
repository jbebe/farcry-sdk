<UserControl x:Class="JackAll.App.FileHandlers.DepLoad.DependencyLinkHandler"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="16">
        <TextBlock x:Name="StatusText" DockPanel.Dock="Top" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" />

        <Button x:Name="GoToFileButton" DockPanel.Dock="Top" Content="Go to file" Click="GoToFile_Click"
                Padding="10,6" HorizontalAlignment="Left" Margin="0,16,0,0" IsEnabled="False" />
    </DockPanel>
</UserControl>
