<UserControl x:Class="JackAll.App.FileHandlers.DepLoad.DepLoadFileHandler"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="16">
        <TextBlock x:Name="StatusText" DockPanel.Dock="Top" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" />

        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Foreground="#666" Margin="0,12,0,12"
                   Text="A dependency-preload index, not embedded file content - expand this file in the tree to browse and jump to what it links to." />

        <Border Background="#FAFAFA" BorderBrush="#DDD" BorderThickness="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                <TextBlock x:Name="Outline" FontFamily="Consolas" FontSize="12" Margin="8" />
            </ScrollViewer>
        </Border>
    </DockPanel>
</UserControl>
