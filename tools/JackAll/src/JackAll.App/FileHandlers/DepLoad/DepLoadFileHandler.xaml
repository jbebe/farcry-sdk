<UserControl x:Class="JackAll.App.FileHandlers.DepLoad.DepLoadFileHandler"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="16">
        <TextBlock x:Name="HeaderText" DockPanel.Dock="Top" FontWeight="Bold" TextWrapping="Wrap" />

        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Foreground="#666" Margin="0,12,0,0"
                   Text="Expand this file in the tree to browse one resource at a time. Each entry is that resource's whole dependency list, and mirroring one to the workspace stages it as a fragment override - the same unit a mod ships." />

        <TextBlock x:Name="TypesText" DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,12,0,0"
                   FontFamily="Consolas" FontSize="11" Foreground="#555" />

        <TextBlock />
    </DockPanel>
</UserControl>
