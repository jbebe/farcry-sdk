<UserControl x:Class="JackAll.App.FileHandlers.Domino.DominoInspector"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:audio="clr-namespace:JackAll.App.FileHandlers.Audio">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        </Style>
        <Style x:Key="FieldValue" TargetType="TextBlock" BasedOn="{StaticResource MonoSmall}">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <!-- One button per action a value or box offers; the click runs the bound DominoAction. -->
        <DataTemplate x:Key="ActionButtons">
            <ItemsControl ItemsSource="{Binding}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Content="{Binding Label}" Click="Action_Click" FontSize="{StaticResource FontSizeSmall}"
                                Style="{StaticResource DenseButton}" Margin="0,2,4,0" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DataTemplate>
    </UserControl.Resources>

    <DockPanel>
    <Border x:Name="PlayerSection" DockPanel.Dock="Bottom" Visibility="Collapsed" Background="{DynamicResource SurfaceAltBrush}"
            BorderBrush="{DynamicResource BorderHairlineBrush}" BorderThickness="0,1,0,0" Padding="10,6">
        <StackPanel>
            <TextBlock x:Name="PlayerLabel" Style="{StaticResource MonoSmall}" Margin="0,0,0,4" />
            <audio:AudioPreviewPanel x:Name="Player" />
            <TextBlock x:Name="PlayerStatus" Style="{StaticResource Caption}" Foreground="{DynamicResource WarningTextBrush}" TextWrapping="Wrap" />
        </StackPanel>
    </Border>
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10,8">
        <StackPanel x:Name="Root">
            <TextBlock x:Name="EmptyNotice"
                       Text="Select a box on the canvas to inspect it."
                       FontSize="{StaticResource FontSizeSecondary}" Style="{StaticResource EmptyHint}" Margin="0,4" />

            <StackPanel x:Name="Details" Visibility="Collapsed">
                <TextBlock x:Name="NodeTitle" Style="{StaticResource Heading}" />
                <TextBlock x:Name="NodeCategory" Style="{StaticResource FieldLabel}" Margin="0,1,0,0" />
                <TextBlock x:Name="NodeDescription" FontSize="{StaticResource FontSizeSecondary}" TextWrapping="Wrap" Margin="0,8,0,0" />
                <TextBlock x:Name="NodeDescriptionSource" Text="Written from the box's Lua implementation."
                           Style="{StaticResource Caption}" Margin="0,2,0,0" />
                <ContentControl x:Name="NodeActions" ContentTemplate="{StaticResource ActionButtons}" Margin="0,6,0,0" />

                <TextBlock Text="TYPE" Style="{StaticResource SectionHeader}" />
                <TextBlock x:Name="NodeTypePath" Style="{StaticResource FieldValue}" />
                <TextBlock x:Name="NodeInstance" Style="{StaticResource FieldValue}" Foreground="{DynamicResource TextSecondaryBrush}" />
                <TextBlock x:Name="SignatureNotice" Style="{StaticResource FieldValue}" Foreground="{DynamicResource WarningTextBrush}"
                           Visibility="Collapsed" />

                <TextBlock x:Name="ParamsHeader" Text="PARAMETERS" Style="{StaticResource SectionHeader}" />
                <ItemsControl x:Name="ParamList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" MinWidth="110" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Name}" Style="{StaticResource FieldLabel}" Margin="0,0,8,0" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Value}" Style="{StaticResource MonoSmall}"
                                               TextWrapping="Wrap" ToolTip="{Binding Value}" />
                                    <TextBlock Text="{Binding Resolved}" FontSize="{StaticResource FontSizeSmall}" Foreground="#2F5E8C" TextWrapping="Wrap"
                                               Visibility="{Binding HasResolved, Converter={StaticResource BoolToVisibility}}" />
                                    <Image Source="{Binding Thumbnail}" MaxWidth="160" MaxHeight="160" HorizontalAlignment="Left"
                                           Margin="0,2,0,0" Stretch="Uniform" />
                                    <ContentControl Content="{Binding Actions}" ContentTemplate="{StaticResource ActionButtons}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock x:Name="PinsHeader" Text="PINS" Style="{StaticResource SectionHeader}" />
                <ItemsControl x:Name="PinList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" MinWidth="56" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="{Binding Direction}" Style="{StaticResource Note}" />
                                <TextBlock Grid.Column="1" Text="{Binding Name}" Style="{StaticResource MonoSmall}"
                                           TextWrapping="Wrap" />
                                <TextBlock Grid.Column="2" Text="{Binding Detail}" Style="{StaticResource Caption}"
                                           Margin="6,0,0,0" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding Note}"
                                           Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,1,0,2"
                                           Visibility="{Binding HasNote, Converter={StaticResource BoolToVisibility}}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- Whole-file facts. Hidden while a node is selected: at that point the question is about
                 the box, not the script it lives in. -->
            <StackPanel x:Name="GraphSection">
                <TextBlock Text="GRAPH" Style="{StaticResource SectionHeader}" />
                <TextBlock x:Name="GraphSummary" Style="{StaticResource FieldValue}" Foreground="{DynamicResource TextSecondaryBrush}" />

                <TextBlock x:Name="DepsHeader" Text="REGISTERED NODE TYPES" Style="{StaticResource SectionHeader}"
                           Visibility="Collapsed" />
                <ItemsControl x:Name="DepList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" Style="{StaticResource MonoSmall}" Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" Margin="0,0,0,2" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock x:Name="ResourcesHeader" Text="LOADED RESOURCES" Style="{StaticResource SectionHeader}"
                           Visibility="Collapsed" />
                <ItemsControl x:Name="ResourceList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" Style="{StaticResource MonoSmall}" Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" Margin="0,0,0,2" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
    </DockPanel>
</UserControl>
