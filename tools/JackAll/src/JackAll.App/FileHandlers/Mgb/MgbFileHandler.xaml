<UserControl x:Class="JackAll.App.FileHandlers.Mgb.MgbFileHandler"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <!-- One template per leaf kind. The set is small and closed (integer, optional integer,
             bool, string, read-only blob), which is exactly why a hand-rolled grid beats a generic
             reflection-driven PropertyGrid here. -->
        <DataTemplate x:Key="PropertyRowTemplate">
            <Grid Margin="0,1,0,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="190" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" Margin="0,0,8,0"
                           Foreground="#444" ToolTip="{Binding Name}" TextTrimming="CharacterEllipsis" />
                <CheckBox Grid.Column="1" IsChecked="{Binding BoolValue}" VerticalAlignment="Center"
                          Visibility="{Binding IsBool, Converter={StaticResource BoolToVisibility}}" />
                <TextBox Grid.Column="1" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                         FontFamily="Consolas" FontSize="12"
                         Visibility="{Binding IsText, Converter={StaticResource BoolToVisibility}}"
                         ToolTip="{Binding Error}">
                    <TextBox.Style>
                        <Style TargetType="TextBox">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsValid}" Value="False">
                                    <Setter Property="Background" Value="#FFF0F0" />
                                    <Setter Property="BorderBrush" Value="#C00" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>
                <TextBlock Grid.Column="1" Text="{Binding Text}" FontFamily="Consolas" FontSize="12"
                           Foreground="#777" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           Visibility="{Binding IsReadOnly, Converter={StaticResource BoolToVisibility}}" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <DockPanel Margin="12">
        <TextBlock x:Name="HeaderText" DockPanel.Dock="Top" FontFamily="Consolas" FontSize="12"
                   TextWrapping="Wrap" Margin="0,0,0,8" />

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <Button x:Name="AddButton" Content="Add…" Click="AddButton_Click" Padding="8,3" Margin="0,0,6,0" />
            <Button x:Name="DuplicateButton" Content="Duplicate" Click="DuplicateButton_Click" Padding="8,3" Margin="0,0,6,0" />
            <Button x:Name="DeleteButton" Content="Delete" Click="DeleteButton_Click" Padding="8,3" Margin="0,0,6,0" />
            <Button x:Name="MoveUpButton" Content="↑" Click="MoveUpButton_Click" Padding="10,3" Margin="0,0,6,0" />
            <Button x:Name="MoveDownButton" Content="↓" Click="MoveDownButton_Click" Padding="10,3" Margin="0,0,18,0" />
            <Button x:Name="SaveButton" Content="Save changes" Click="SaveButton_Click" Padding="10,3" FontWeight="Bold" />
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" MinWidth="220" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="3*" MinWidth="260" />
            </Grid.ColumnDefinitions>

            <TreeView x:Name="Tree" SelectedItemChanged="Tree_SelectedItemChanged" BorderThickness="1"
                      BorderBrush="#DDD">
                <TreeView.ItemContainerStyle>
                    <Style TargetType="TreeViewItem">
                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                    </Style>
                </TreeView.ItemContainerStyle>
                <TreeView.ItemTemplate>
                    <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                        <TextBlock Text="{Binding Label}" FontFamily="Consolas" FontSize="12" />
                    </HierarchicalDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" Background="Transparent" />

            <DockPanel Grid.Column="2">
                <TextBlock x:Name="SelectionText" DockPanel.Dock="Top" FontWeight="Bold" Margin="8,0,0,6" />
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="Properties" Margin="8,0,0,0"
                                  ItemTemplate="{StaticResource PropertyRowTemplate}" />
                </ScrollViewer>
            </DockPanel>
        </Grid>
    </DockPanel>
</UserControl>
