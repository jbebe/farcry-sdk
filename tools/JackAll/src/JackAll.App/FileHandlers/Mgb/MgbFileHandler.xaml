<UserControl x:Class="JackAll.App.FileHandlers.Mgb.MgbFileHandler"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="16">
        <TextBlock x:Name="HeaderText" DockPanel.Dock="Top" FontFamily="Consolas" FontSize="12"
                   TextWrapping="Wrap" Margin="0,0,0,8" />

        <Expander x:Name="ToolsExpander" Header="Mod Configuration Menu tools" DockPanel.Dock="Top"
                  Margin="0,0,0,8" IsExpanded="False">
            <StackPanel Margin="8">
                <TextBlock Text="Replace this file's content with a freshly built Mods page:"
                           FontWeight="Bold" Margin="0,4,0,4" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <TextBlock Text="Page width:" VerticalAlignment="Center" Width="90" />
                    <TextBox x:Name="PageWidthBox" Width="60" Text="1024" />
                    <TextBlock Text="height:" VerticalAlignment="Center" Width="50" Margin="8,0,0,0" />
                    <TextBox x:Name="PageHeightBox" Width="60" Text="768" />
                </StackPanel>
                <TextBlock Text="One checkbox row per line - plain &quot;Label&quot;, or &quot;Label = on&quot; to start checked:"
                           TextWrapping="Wrap" Margin="0,4,0,4" />
                <TextBox x:Name="CheckBoxRowsBox" Height="80" AcceptsReturn="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12" />
                <Button x:Name="BuildModsPageButton" Content="Build and replace this file"
                        Click="BuildModsPageButton_Click" HorizontalAlignment="Left" Margin="0,8,0,0" Padding="8,4" />

                <Separator Margin="0,12,0,12" />

                <TextBlock Text="Add a Button to a top-level Page already in this file:"
                           FontWeight="Bold" Margin="0,0,0,4" />
                <TextBlock x:Name="PageLocationsText" TextWrapping="Wrap" Foreground="#555" Margin="0,0,0,4" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <TextBlock Text="Page index:" VerticalAlignment="Center" Width="90" />
                    <TextBox x:Name="PageIndexBox" Width="40" Text="0" />
                    <TextBlock Text="Button label:" VerticalAlignment="Center" Width="80" Margin="8,0,0,0" />
                    <TextBox x:Name="ButtonLabelBox" Width="200" Text="Mod Configuration Menu" />
                </StackPanel>
                <Button x:Name="AddButtonButton" Content="Add button and replace this file"
                        Click="AddButtonButton_Click" HorizontalAlignment="Left" Margin="0,4,0,0" Padding="8,4"
                        IsEnabled="False" />

                <TextBlock x:Name="ToolsStatusText" Margin="0,8,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </Expander>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
            <TreeView x:Name="Tree" BorderThickness="0" />
        </ScrollViewer>
    </DockPanel>
</UserControl>
