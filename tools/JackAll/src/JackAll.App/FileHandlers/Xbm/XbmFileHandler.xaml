<UserControl x:Class="JackAll.App.FileHandlers.Xbm.XbmFileHandler"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:JackAll.App"
             xmlns:xbm="clr-namespace:JackAll.App.FileHandlers.Xbm">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <DataTemplate x:Key="RowTemplate" DataType="{x:Type xbm:MaterialRow}">
            <StackPanel Margin="0,0,0,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="190" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Key}" VerticalAlignment="Center" Style="{StaticResource Secondary}" />
                    <TextBox Grid.Column="1" Text="{Binding Text, UpdateSourceTrigger=LostFocus}"
                             app:CommitOnEnter.IsEnabled="True" AutomationProperties.Name="{Binding Key}" />
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Border Width="22" Height="22" Margin="6,0,0,0" BorderThickness="1"
                                BorderBrush="{DynamicResource ControlBorderBrush}" Background="{Binding Swatch}"
                                Visibility="{Binding HasSwatch, Converter={StaticResource BoolToVis}}" />
                        <Button Content="Pick…" Click="PickTexture_Click" Margin="6,0,0,0" Style="{StaticResource DenseButton}"
                                ToolTip="Pick a texture from the game archives and the workspace"
                                Visibility="{Binding IsTexture, Converter={StaticResource BoolToVis}}" />
                        <Button Content="Go to →" Click="GoTo_Click" Margin="6,0,0,0" Style="{StaticResource DenseButton}"
                                Visibility="{Binding HasTexture, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </Grid>
                <TextBlock Text="{Binding Hint}" Style="{StaticResource Note}" Margin="190,2,0,0"
                           Visibility="{Binding HasHint, Converter={StaticResource BoolToVis}}" />
                <TextBlock Text="{Binding Problem}" Foreground="{DynamicResource WarningTextBrush}" TextWrapping="Wrap"
                           Margin="190,2,0,0" Visibility="{Binding HasProblem, Converter={StaticResource BoolToVis}}" />
                <Image Source="{Binding Thumbnail, IsAsync=True}" MaxWidth="96" MaxHeight="96" Stretch="Uniform"
                       HorizontalAlignment="Left" Margin="190,4,0,0"
                       Visibility="{Binding HasTexture, Converter={StaticResource BoolToVis}}" />
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <DockPanel Margin="16">
        <Grid DockPanel.Dock="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="190" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="Name" VerticalAlignment="Center" Style="{StaticResource Secondary}" />
            <TextBox x:Name="NameBox" Grid.Column="1" LostFocus="Name_LostFocus" app:CommitOnEnter.IsEnabled="True"
                     AutomationProperties.AutomationId="XbmName" />
            <TextBlock Grid.Row="1" Text="Shader" VerticalAlignment="Center" Margin="0,6,0,0" Style="{StaticResource Secondary}" />
            <ComboBox x:Name="ShaderPicker" Grid.Row="1" Grid.Column="1" Margin="0,6,0,0"
                      SelectionChanged="Shader_SelectionChanged" AutomationProperties.AutomationId="XbmShader" />
        </Grid>

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,10,0,0">
            <CheckBox x:Name="ShowAllBox" Content="Show every property the shader takes" Click="Options_Click" />
            <CheckBox x:Name="LinkBox" Content="Set Clean twins along" IsChecked="True" Margin="16,0,0,0"
                      ToolTip="A weapon's or vehicle's condition overwrites a colour from its Clean and Broken twins. With this on, setting the colour sets its Clean twin too; Broken stays the worn look." />
        </StackPanel>

        <TextBlock x:Name="StatusText" DockPanel.Dock="Top" Style="{StaticResource Note}" Margin="0,6,0,0"
                   AutomationProperties.AutomationId="XbmStatus" />

        <Border x:Name="ProblemsPanel" DockPanel.Dock="Top" Style="{StaticResource WarningCallout}" Margin="0,8,0,0"
                Visibility="Collapsed">
            <TextBlock x:Name="ProblemsText" TextWrapping="Wrap" />
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,4,0,0">
            <ItemsControl x:Name="GroupsList" AutomationProperties.AutomationId="XbmProperties">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type xbm:MaterialGroup}">
                        <StackPanel>
                            <TextBlock Text="{Binding Header}" Style="{StaticResource SectionHeader}" />
                            <ItemsControl ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource RowTemplate}" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
