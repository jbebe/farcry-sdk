<UserControl x:Class="JackAll.App.FileHandlers.Mft.MftFileHandler"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="16">
        <TextBlock x:Name="StatusText" DockPanel.Dock="Top" Style="{StaticResource Mono}" TextWrapping="Wrap" />

        <!-- Sample text set from the font's own pages, at their size. -->
        <Border Margin="0,16,0,0" Style="{StaticResource InertFrame}">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <Image x:Name="Preview" Stretch="None" HorizontalAlignment="Left" VerticalAlignment="Top" />
            </ScrollViewer>
        </Border>
    </DockPanel>
</UserControl>
