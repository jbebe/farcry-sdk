<Window x:Class="JackAll.App.FileHandlers.Mft.FontWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Make a font" Width="820" Height="640" MinWidth="620" MinHeight="460"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextPrimaryBrush}">
    <Window.Resources>
        <!-- Centred on its control, whose bottom margin spaces the rows. -->
        <Style x:Key="Label" TargetType="TextBlock" BasedOn="{StaticResource ToolbarLabel}">
            <Setter Property="Margin" Value="0,0,10,6" />
        </Style>
    </Window.Resources>

    <DockPanel Margin="12">
        <Grid DockPanel.Dock="Top" Grid.IsSharedSizeScope="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" SharedSizeGroup="Label" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Font file" Style="{StaticResource Label}" />
            <TextBox x:Name="FileBox" Grid.Row="0" Grid.Column="1" IsReadOnly="True" Margin="0,0,6,6"
                     AutomationProperties.AutomationId="FontWizardFile" />
            <Button Grid.Row="0" Grid.Column="2" Content="Browse…" Click="Browse_Click" Margin="0,0,0,6"
                    AutomationProperties.AutomationId="FontWizardBrowse" />

            <TextBlock Grid.Row="1" Text="Font" Style="{StaticResource Label}" />
            <ComboBox x:Name="FacePicker" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,6"
                      SelectionChanged="Face_SelectionChanged" AutomationProperties.AutomationId="FontWizardFace" />

            <!-- A variable font's design axes, its weight above all, one slider each. -->
            <ItemsControl x:Name="AxisList" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="Label" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Label}" Style="{StaticResource Label}" />
                            <Slider Grid.Column="1" Minimum="{Binding Minimum}" Maximum="{Binding Maximum}" Value="{Binding Value}"
                                    VerticalAlignment="Center" Margin="0,0,0,6" ValueChanged="Setting_Changed" />
                            <TextBlock Grid.Column="2" Text="{Binding Value, StringFormat={}{0:0}}" MinWidth="48" TextAlignment="Right"
                                       VerticalAlignment="Center" Margin="0,0,0,6" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Grid.Row="3" Text="Size" Style="{StaticResource Label}" />
            <DockPanel Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,6">
                <TextBlock DockPanel.Dock="Right" MinWidth="48" TextAlignment="Right" VerticalAlignment="Center"
                           Text="{Binding Value, ElementName=SizeSlider, StringFormat={}{0:0} px}" />
                <Slider x:Name="SizeSlider" Minimum="10" Maximum="96" Value="25" IsSnapToTickEnabled="True" TickFrequency="1"
                        VerticalAlignment="Center" ValueChanged="Size_Changed" AutomationProperties.AutomationId="FontWizardSize" />
            </DockPanel>

            <TextBlock Grid.Row="4" Text="Name" Style="{StaticResource Label}" />
            <TextBox x:Name="NameBox" Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,6"
                     TextChanged="Setting_Changed" AutomationProperties.AutomationId="FontWizardName" />

            <TextBlock Grid.Row="5" Text="Sample" Style="{StaticResource Label}" />
            <TextBox x:Name="SampleBox" Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,6"
                     AcceptsReturn="True" TextChanged="Sample_Changed" AutomationProperties.AutomationId="FontWizardSample" />
        </Grid>

        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <Button DockPanel.Dock="Right" Content="Cancel" IsCancel="True" Margin="6,0,0,0" MinWidth="80"
                    AutomationProperties.AutomationId="FontWizardCancel" />
            <Button x:Name="StageButton" DockPanel.Dock="Right" Content="Stage in workspace" Style="{StaticResource PrimaryButton}"
                    MinWidth="80" IsEnabled="False" Click="Stage_Click" AutomationProperties.AutomationId="FontWizardStage" />
            <TextBlock x:Name="StatusText" Style="{StaticResource Muted}" TextWrapping="Wrap" VerticalAlignment="Center"
                       Text="Pick a TrueType or OpenType file." />
        </DockPanel>

        <!-- The sample as the game sets it, from the pages the font will ship with, at their size. -->
        <Border Style="{StaticResource InertFrame}">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <Image x:Name="Preview" Stretch="None" HorizontalAlignment="Left" VerticalAlignment="Top" />
            </ScrollViewer>
        </Border>
    </DockPanel>
</Window>
