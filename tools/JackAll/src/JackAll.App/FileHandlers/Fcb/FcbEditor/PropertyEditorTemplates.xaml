<ResourceDictionary x:Class="JackAll.App.FileHandlers.Fcb.FcbEditor.PropertyEditorTemplates"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:fcbEditor="clr-namespace:JackAll.App.FileHandlers.Fcb.FcbEditor">
    <!-- The value editor for each field shape, shared by every property grid that shows PropertyRows. -->
    <!-- One scalar field: a plain value, a whole Vector2/3/4, or one labelled Matrix4 cell. -->
    <DataTemplate DataType="{x:Type fcbEditor:ScalarField}">
        <DockPanel Margin="0,2">
            <TextBlock DockPanel.Dock="Left" Text="{Binding Label}" Width="28" VerticalAlignment="Center">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource Secondary}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Label}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <Button DockPanel.Dock="Right" Content="…" Margin="4,0,0,0" VerticalAlignment="Top"
                    Click="PickFile_Click" ToolTip="Pick a file from the game archives"
                    AutomationProperties.AutomationId="FcbPickFile">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource DenseButton}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsFilePath}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <!-- A colour's swatch, which opens a slider per channel. -->
            <Grid DockPanel.Dock="Left" Margin="0,0,4,0" VerticalAlignment="Center">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsColour}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <ToggleButton x:Name="SwatchButton" Width="22" Height="18" Padding="0" ToolTip="Pick the colour">
                    <Border Background="{Binding Swatch}" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1"
                            Width="16" Height="12" />
                </ToggleButton>
                <Popup IsOpen="{Binding IsChecked, ElementName=SwatchButton}" StaysOpen="False"
                       PlacementTarget="{Binding ElementName=SwatchButton}" Placement="Bottom">
                    <Border Style="{StaticResource PopupSurface}">
                        <StackPanel Width="200">
                            <TextBlock Text="Red" Style="{StaticResource Secondary}" />
                            <Slider Minimum="0" Maximum="1" Value="{Binding Red}" SmallChange="0.01" LargeChange="0.1" />
                            <TextBlock Text="Green" Style="{StaticResource Secondary}" />
                            <Slider Minimum="0" Maximum="1" Value="{Binding Green}" SmallChange="0.01" LargeChange="0.1" />
                            <TextBlock Text="Blue" Style="{StaticResource Secondary}" />
                            <Slider Minimum="0" Maximum="1" Value="{Binding Blue}" SmallChange="0.01" LargeChange="0.1" />
                        </StackPanel>
                    </Border>
                </Popup>
            </Grid>
            <!-- The file a path hash names, under its hex. -->
            <TextBlock DockPanel.Dock="Bottom" Text="{Binding ResolvedPath}" ToolTip="{Binding ResolvedPath}"
                       TextTrimming="CharacterEllipsis" Margin="0,1,0,0">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource MonoNote}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ResolvedPath}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <!-- The Grid is what fills the column; whichever editor shows stretches to it. -->
            <Grid>
                <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}">
                    <TextBox.Style>
                        <!-- Width is a Setter, not an attribute, so the Label trigger below can override it. -->
                        <Style TargetType="TextBox" BasedOn="{StaticResource ValidatedTextBox}">
                            <Setter Property="Width" Value="180" />
                            <Setter Property="HorizontalAlignment" Value="Left" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Label}" Value="{x:Null}">
                                    <Setter Property="Width" Value="NaN" />
                                    <Setter Property="HorizontalAlignment" Value="Stretch" />
                                </DataTrigger>
                                <!-- A Rml field shows the editor below instead. -->
                                <DataTrigger Binding="{Binding Type}" Value="Rml">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <!-- A field with a known option list shows the dropdown below instead. -->
                                <DataTrigger Binding="{Binding HasEnumChoices}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>

                <!-- A decoded .rml document is nested XML, so a Rml field gets an editor instead. -->
                <fcbEditor:RmlTextEditor Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" Margin="0,1">
                    <fcbEditor:RmlTextEditor.Style>
                        <Style TargetType="fcbEditor:RmlTextEditor">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsValid}" Value="False">
                                    <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
                                    <Setter Property="Background" Value="{DynamicResource InvalidBgBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Type}" Value="Rml">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </fcbEditor:RmlTextEditor.Style>
                </fcbEditor:RmlTextEditor>

                <!-- A field with a known option list - see EnumChoices. -->
                <ComboBox ItemsSource="{Binding EnumChoices}" SelectedIndex="{Binding SelectedEnumIndex}">
                    <ComboBox.Style>
                        <Style TargetType="ComboBox" BasedOn="{StaticResource ValidatedComboBox}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasEnumChoices}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ComboBox.Style>
                </ComboBox>
            </Grid>
        </DockPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type fcbEditor:BoolField}">
        <CheckBox IsChecked="{Binding Value}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,2" />
    </DataTemplate>

    <!-- Matrix4 only now - a wrapped grid of already-labeled ScalarFields (R#C#), reusing the
         ScalarField template above. Vector2/3/4 render as a single comma-separated ScalarField
         instead (see FcbFieldFormat), so they never reach this template. -->
    <DataTemplate DataType="{x:Type fcbEditor:VectorFieldGroup}">
        <ItemsControl ItemsSource="{Binding Components}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
        </ItemsControl>
    </DataTemplate>

    <DataTemplate DataType="{x:Type fcbEditor:NumberArrayGroup}">
        <StackPanel>
            <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <DockPanel Margin="0,1">
                            <Button DockPanel.Dock="Right" Content="×" Style="{StaticResource DenseButton}" Margin="4,0,0,0"
                                    Tag="{Binding}" Click="RemoveNumberArrayItem_Click" />
                            <ContentControl Content="{Binding}" />
                        </DockPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Content="+ Add item" HorizontalAlignment="Left" Margin="0,4,0,0" Style="{StaticResource DenseButton}"
                    Click="AddNumberArrayItem_Click" />
        </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type fcbEditor:BoolArrayGroup}">
        <StackPanel>
            <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <DockPanel Margin="0,1">
                            <Button DockPanel.Dock="Right" Content="×" Style="{StaticResource DenseButton}" Margin="4,0,0,0"
                                    Tag="{Binding}" Click="RemoveBoolArrayItem_Click" />
                            <ContentControl Content="{Binding}" />
                        </DockPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Content="+ Add item" HorizontalAlignment="Left" Margin="0,4,0,0" Style="{StaticResource DenseButton}"
                    Click="AddBoolArrayItem_Click" />
        </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type fcbEditor:VectorArrayGroup}">
        <StackPanel>
            <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <DockPanel Margin="0,3">
                            <Button DockPanel.Dock="Right" Content="×" Style="{StaticResource DenseButton}" Margin="4,0,0,0"
                                    VerticalAlignment="Top" Tag="{Binding}" Click="RemoveVectorArrayItem_Click" />
                            <ContentControl Content="{Binding}" />
                        </DockPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Content="+ Add item" HorizontalAlignment="Left" Margin="0,4,0,0" Style="{StaticResource DenseButton}"
                    Click="AddVectorArrayItem_Click" />
        </StackPanel>
    </DataTemplate>

    <!-- One field of an edited node. Inherited is greyed, unset and editor-only text fainter still; an
         override is marked on the left and can be reverted; a value that differs from the document's
         baseline is tinted and can be restored. -->
    <DataTemplate DataType="{x:Type fcbEditor:FieldView}">
        <Border BorderThickness="3,0,0,0" Padding="4,1,0,1" Margin="0,0,0,1">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="BorderBrush" Value="Transparent" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Row.IsChangedFromVanilla}" Value="True">
                            <Setter Property="Background" Value="{DynamicResource WarningBgBrush}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Origin}" Value="Inherited">
                            <Setter Property="Opacity" Value="0.55" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Origin}" Value="Unset">
                            <Setter Property="Opacity" Value="0.4" />
                            <Setter Property="ToolTip" Value="Not set: the engine keeps its own default. Editing writes it into the instance." />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Origin}" Value="Overridden">
                            <Setter Property="BorderBrush" Value="{DynamicResource WarningAccentBrush}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Row.IsEditorText}" Value="True">
                            <Setter Property="Opacity" Value="0.4" />
                            <Setter Property="ToolTip" Value="{Binding Row.EditorTextTip}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Restore" Margin="6,0,0,0"
                        VerticalAlignment="Center" Click="RestoreField_Click"
                        ToolTip="Sets this field back to the value the document had when it was opened">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource DenseButton}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Row.IsChangedFromVanilla}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button DockPanel.Dock="Right" Content="Revert" Margin="6,0,0,0"
                        VerticalAlignment="Center" Click="RevertField_Click"
                        ToolTip="Removes this override, so the archetype's value applies again">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource DenseButton}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CanRevert}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <TextBlock DockPanel.Dock="Left" Width="160" Text="{Binding Row.DisplayName}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Row.Type}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Origin}" Value="Overridden">
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <ContentControl Content="{Binding Row.Editor}" VerticalAlignment="Center" />
            </DockPanel>
        </Border>
    </DataTemplate>
</ResourceDictionary>
