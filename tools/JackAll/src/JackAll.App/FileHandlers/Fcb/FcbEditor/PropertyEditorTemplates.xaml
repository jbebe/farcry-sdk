<ResourceDictionary x:Class="JackAll.App.FileHandlers.Fcb.FcbEditor.PropertyEditorTemplates"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:fcbEditor="clr-namespace:JackAll.App.FileHandlers.Fcb.FcbEditor">
    <!-- The value editor for each field shape, shared by every property grid that shows PropertyRows. -->
    <!-- One scalar field: a plain value, a whole Vector2/3/4, or one labelled Matrix4 cell. -->
    <DataTemplate DataType="{x:Type fcbEditor:ScalarField}">
        <DockPanel Margin="0,2">
            <TextBlock DockPanel.Dock="Left" Text="{Binding Label}" Width="28" VerticalAlignment="Center" Foreground="#666">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Label}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <!-- The Grid is what fills the column; whichever editor shows stretches to it. -->
            <Grid>
                <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" Padding="3,1">
                    <TextBox.Style>
                        <!-- Width is a Setter, not an attribute, so the Label trigger below can override it. -->
                        <Style TargetType="TextBox">
                            <Setter Property="Width" Value="180" />
                            <Setter Property="HorizontalAlignment" Value="Left" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsValid}" Value="False">
                                    <Setter Property="BorderBrush" Value="Red" />
                                    <Setter Property="BorderThickness" Value="1.5" />
                                    <Setter Property="Background" Value="#FFF0F0" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Label}" Value="{x:Null}">
                                    <Setter Property="Width" Value="NaN" />
                                    <Setter Property="HorizontalAlignment" Value="Stretch" />
                                </DataTrigger>
                                <!-- A Rml field shows the editor below instead. -->
                                <DataTrigger Binding="{Binding Type}" Value="Rml">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <!-- A field with a known option list shows the dropdown below instead. -->
                                <DataTrigger Binding="{Binding HasEnumChoices}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>

                <!-- A decoded .rml document is nested XML, so a Rml field gets an editor instead. -->
                <fcbEditor:RmlTextEditor Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" Margin="0,1">
                    <fcbEditor:RmlTextEditor.Style>
                        <Style TargetType="fcbEditor:RmlTextEditor">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsValid}" Value="False">
                                    <Setter Property="BorderBrush" Value="Red" />
                                    <Setter Property="BorderThickness" Value="1.5" />
                                    <Setter Property="Background" Value="#FFF0F0" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Type}" Value="Rml">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </fcbEditor:RmlTextEditor.Style>
                </fcbEditor:RmlTextEditor>

                <!-- A field with a known option list - see EnumChoices. -->
                <ComboBox ItemsSource="{Binding EnumChoices}" SelectedIndex="{Binding SelectedEnumIndex}"
                          Padding="3,1">
                    <ComboBox.Style>
                        <Style TargetType="ComboBox">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsValid}" Value="False">
                                    <Setter Property="BorderBrush" Value="Red" />
                                    <Setter Property="BorderThickness" Value="1.5" />
                                    <Setter Property="Background" Value="#FFF0F0" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding HasEnumChoices}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ComboBox.Style>
                </ComboBox>
            </Grid>
        </DockPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type fcbEditor:BoolField}">
        <CheckBox IsChecked="{Binding Value}" VerticalAlignment="Center" Margin="0,2" />
    </DataTemplate>

    <!-- Matrix4 only now - a wrapped grid of already-labeled ScalarFields (R#C#), reusing the
         ScalarField template above. Vector2/3/4 render as a single comma-separated ScalarField
         instead (see FcbFieldFormat), so they never reach this template. -->
    <DataTemplate DataType="{x:Type fcbEditor:VectorFieldGroup}">
        <ItemsControl ItemsSource="{Binding Components}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
        </ItemsControl>
    </DataTemplate>

    <DataTemplate DataType="{x:Type fcbEditor:NumberArrayGroup}">
        <StackPanel>
            <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <DockPanel Margin="0,1">
                            <Button DockPanel.Dock="Right" Content="×" Padding="6,0" Margin="4,0,0,0"
                                    Tag="{Binding}" Click="RemoveNumberArrayItem_Click" />
                            <ContentControl Content="{Binding}" />
                        </DockPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Content="+ Add item" HorizontalAlignment="Left" Margin="0,4,0,0" Padding="6,2"
                    Click="AddNumberArrayItem_Click" />
        </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type fcbEditor:BoolArrayGroup}">
        <StackPanel>
            <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <DockPanel Margin="0,1">
                            <Button DockPanel.Dock="Right" Content="×" Padding="6,0" Margin="4,0,0,0"
                                    Tag="{Binding}" Click="RemoveBoolArrayItem_Click" />
                            <ContentControl Content="{Binding}" />
                        </DockPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Content="+ Add item" HorizontalAlignment="Left" Margin="0,4,0,0" Padding="6,2"
                    Click="AddBoolArrayItem_Click" />
        </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type fcbEditor:VectorArrayGroup}">
        <StackPanel>
            <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <DockPanel Margin="0,3">
                            <Button DockPanel.Dock="Right" Content="×" Padding="6,0" Margin="4,0,0,0"
                                    VerticalAlignment="Top" Tag="{Binding}" Click="RemoveVectorArrayItem_Click" />
                            <ContentControl Content="{Binding}" />
                        </DockPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Content="+ Add item" HorizontalAlignment="Left" Margin="0,4,0,0" Padding="6,2"
                    Click="AddVectorArrayItem_Click" />
        </StackPanel>
    </DataTemplate>

    <!-- One field of an edited node. Inherited is greyed and unset fainter still; an override is marked
         on the left and can be reverted; a value that differs from the document's baseline is tinted
         and can be restored. -->
    <DataTemplate DataType="{x:Type fcbEditor:FieldView}">
        <Border BorderThickness="3,0,0,0" Padding="4,1,0,1" Margin="0,0,0,1">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="BorderBrush" Value="Transparent" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Row.IsChangedFromVanilla}" Value="True">
                            <Setter Property="Background" Value="#FFF6D6" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Origin}" Value="Inherited">
                            <Setter Property="Opacity" Value="0.55" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Origin}" Value="Unset">
                            <Setter Property="Opacity" Value="0.4" />
                            <Setter Property="ToolTip" Value="Not set: the engine keeps its own default. Editing writes it into the instance." />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Origin}" Value="Overridden">
                            <Setter Property="BorderBrush" Value="#E08A00" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Restore" Padding="5,0" Margin="6,0,0,0"
                        VerticalAlignment="Center" Click="RestoreField_Click"
                        ToolTip="Sets this field back to the value the document had when it was opened">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Row.IsChangedFromVanilla}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button DockPanel.Dock="Right" Content="Revert" Padding="5,0" Margin="6,0,0,0"
                        VerticalAlignment="Center" Click="RevertField_Click"
                        ToolTip="Removes this override, so the archetype's value applies again">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CanRevert}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <TextBlock DockPanel.Dock="Left" Width="160" Text="{Binding Row.DisplayName}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Row.Type}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Origin}" Value="Overridden">
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <ContentControl Content="{Binding Row.Editor}" VerticalAlignment="Center" />
            </DockPanel>
        </Border>
    </DataTemplate>
</ResourceDictionary>
