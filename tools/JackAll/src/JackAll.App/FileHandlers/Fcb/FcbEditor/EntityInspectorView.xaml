<UserControl x:Class="JackAll.App.FileHandlers.Fcb.FcbEditor.EntityInspectorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fcbEditor="clr-namespace:JackAll.App.FileHandlers.Fcb.FcbEditor">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <fcbEditor:PropertyEditorTemplates />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="Visible" />

            <!-- A node and everything below it; collapsing it hides the whole subtree. -->
            <DataTemplate DataType="{x:Type fcbEditor:NodeView}">
                <Expander IsExpanded="{Binding IsExpanded}">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
                            <Button Content="Remove" Style="{StaticResource DenseButton}" Margin="8,0,0,0" Click="RemoveComponent_Click"
                                    Visibility="{Binding CanRemove, Converter={StaticResource Visible}}"
                                    ToolTip="Removes this component from the instance" />
                        </StackPanel>
                    </Expander.Header>
                    <StackPanel Margin="14,2,0,4">
                        <ItemsControl ItemsSource="{Binding Fields}" />
                        <ItemsControl ItemsSource="{Binding Sections}" />
                    </StackPanel>
                </Expander>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel>
        <ItemsControl ItemsSource="{Binding Sections}" />
        <DockPanel Margin="0,8,0,0">
            <Button DockPanel.Dock="Right" Content="Add component" Style="{StaticResource DenseButton}" Margin="6,0,0,0"
                    Click="AddComponent_Click"
                    ToolTip="Adds the chosen component to this instance. Its properties stay at the engine's defaults until edited." />
            <ComboBox x:Name="ComponentToAdd" ItemsSource="{Binding AddableComponents}" IsEditable="True"
                      IsTextSearchEnabled="True" />
        </DockPanel>
    </StackPanel>
</UserControl>
