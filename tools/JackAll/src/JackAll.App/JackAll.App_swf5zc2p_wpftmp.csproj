<Project>
  <PropertyGroup>
    <AssemblyName>JackAll</AssemblyName>
    <IntermediateOutputPath>obj\Debug\</IntermediateOutputPath>
    <BaseIntermediateOutputPath>obj\</BaseIntermediateOutputPath>
    <MSBuildProjectExtensionsPath>C:\Projects\FarCry2\tools\JackAll\src\JackAll.App\obj\</MSBuildProjectExtensionsPath>
    <_TargetAssemblyProjectName>JackAll.App</_TargetAssemblyProjectName>
    <RootNamespace>JackAll.App</RootNamespace>
  </PropertyGroup>
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />
  <ItemGroup>
    <ProjectReference Include="..\JackAll.Core\JackAll.Core.csproj" />
    <ProjectReference Include="..\JackAll.Tools\JackAll.Tools.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="AvalonEdit" Version="6.3.1.120" />
    <PackageReference Include="DiffPlex" Version="1.9.0" />
    <PackageReference Include="FFMpegCore" Version="5.1.0" />
    <PackageReference Include="ini-parser-netstandard" Version="2.5.3" />
    <!--
      The node-graph canvas behind the Domino mission-graph viewer. Chosen over the other WPF node
      editors because it ships a real net10.0-windows target (matching this project's TFM exactly)
      and has no dependencies of its own beyond WPF - it is a control library, not a framework, so
      it binds to our own view models and imposes no document model on ReconstructedGraph.
    -->
    <PackageReference Include="Nodify" Version="7.3.0" />
    <PackageReference Include="OpenTK.GLWpfControl" Version="4.3.6" />
  </ItemGroup>
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!--
      Server GC: the first-launch .fcb pass (GameVfs.MergeFragments) decodes tens of thousands of
      containers in parallel across every core, and each one allocates. Under the default Workstation
      GC every gen0 collection is stop-the-world across all those threads, so the parallel decode
      barely beats the old serial pass. Server GC gives each logical core its own heap and a dedicated
      background collector, which is what lets that allocation-bound fan-out actually scale.
      Background collection stays on (default under Server GC) so the UI thread isn't paused during
      steady-state use.
    -->
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <RootNamespace>JackAll.App</RootNamespace>
    <ApplicationIcon>Icon.ico</ApplicationIcon>
    <Product>JackAll</Product>
    <Description>A jack of all trades for Far Cry 2 modding. Named for the Jackal.</Description>
  </PropertyGroup>
  <!--
    What a user unzips is JackAll.exe, a config.ini, a data folder, and a workspace folder - nothing
    else. No runtime to install, no loose NuGet DLLs to lose track of, no .pdb sitting next to the exe.

    Gated on _IsPublishing so this only costs anything at `dotnet publish`; a plain `dotnet build`
    stays a fast framework-dependent build, and `dotnet test` doesn't drag a whole runtime along.

    Trimming is deliberately absent: WPF doesn't support it, and turning it on produces an exe that
    builds fine and then dies on the first XAML load.
  -->
  <PropertyGroup Condition="'$(_IsPublishing)' == 'true'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishReadyToRun>true</PublishReadyToRun>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <DebugType>none</DebugType>
    <!-- DebugType only silences this project's own pdb; this drops the referenced projects' too. -->
    <AllowedReferenceRelatedFileExtensions>none</AllowedReferenceRelatedFileExtensions>
  </PropertyGroup>
  <!--
    The name dictionary ships in data\. Without it the tool still works, but every file shows up as
    a bare hash - so it is part of the product, not an optional extra.
  -->
  <ItemGroup>
    <Content Include="..\..\assets\fc2.hashlist" Link="data\.itemhashes">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\assets\binary_classes.xml" Link="data\.fcbclasses">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\assets\vanilla_hashes.ini" Link="data\.archivehashes">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\assets\savegame_field_names.tsv" Link="data\.savegamefieldnames">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Icon.ico" />
  </ItemGroup>
  <!--
    Bundled so .sbao import/export/preview works out of the box - no separate ffmpeg install to ask
    users for. ExcludeFromSingleFile is required despite this being a plain Content item: with
    IncludeNativeLibrariesForSelfExtract=true (below), the single-file publisher auto-detects any
    native PE - including a Content-linked one like this, not just actual native dependencies - and
    bundles it into the exe instead of leaving it on disk. FfmpegAudio shells out to a real file at
    data\ffmpeg.exe, so it must stay loose; without this, a self-contained publish silently produces
    an exe with no ffmpeg.exe next to it and every .sbao import/export throws at runtime.
  -->
  <ItemGroup>
    <Content Include="..\..\assets\ffmpeg.exe" Link="data\ffmpeg.exe">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
  </ItemGroup>
  <!-- Baked into the assembly rather than shipped alongside it, like everything else this exe needs. -->
  <ItemGroup>
    <EmbeddedResource Include="FileHandlers\Text\Lua.xshd" />
  </ItemGroup>
