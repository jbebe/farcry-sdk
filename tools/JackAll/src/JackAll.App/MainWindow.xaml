<Window x:Class="JackAll.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:JackAll.App"
        xmlns:xrefs="clr-namespace:JackAll.App.FileHandlers.Xrefs"
        xmlns:mapEditor="clr-namespace:JackAll.App.MapEditor"
        xmlns:library="clr-namespace:JackAll.App.Library"
        xmlns:move="clr-namespace:JackAll.App.Move"
        Title="JackAll - Far Cry 2 Mod Manager" Height="720" Width="1180"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextPrimaryBrush}">

    <!-- Browser-style history for following references. Bound at the window so they work wherever
         focus happens to be after a jump, not only while the Xrefs grid has it. -->
    <Window.InputBindings>
        <KeyBinding Key="Left" Modifiers="Alt" Command="{x:Static local:MainWindow.NavigateBackCommand}" />
        <KeyBinding Key="Right" Modifiers="Alt" Command="{x:Static local:MainWindow.NavigateForwardCommand}" />
    </Window.InputBindings>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <local:ModuleNameMultiConverter x:Key="ModuleNameConverter" />
        <local:UnusedFileConverter x:Key="UnusedFileConverter" />

        <!-- The Files tab's grey/black convention: a folder is grey until a mod or the workspace changed
             something inside it (FolderTree's style), a file until it was changed itself (FileGrid's). -->
        <HierarchicalDataTemplate x:Key="FolderTemplate" DataType="{x:Type local:FolderNode}"
                                  ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Margin="0,0,4,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="&#128193;" />
                            <Style.Triggers>
                                <!-- No subfolders and no files at all — shown open since there's nothing to reveal. -->
                                <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                                    <Setter Property="Text" Value="&#128194;" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsExpanded, RelativeSource={RelativeSource AncestorType=TreeViewItem}}" Value="True">
                                    <Setter Property="Text" Value="&#128194;" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="{Binding Name}" />
            </StackPanel>
        </HierarchicalDataTemplate>

        <!-- The Mods tab's per-mod details tree (see MainViewModel.SelectedModFiles) - no
             grey/black "contains changes" coloring here, unlike FolderTemplate above: every node in
             this tree is already part of the selected mod's own overrides. -->
        <HierarchicalDataTemplate x:Key="ModFileTemplate" DataType="{x:Type local:ModFileNode}"
                                  ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Margin="0,0,4,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="&#128196;" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsFile}" Value="False">
                                    <Setter Property="Text" Value="&#128193;" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="{Binding Name}" />
            </StackPanel>
        </HierarchicalDataTemplate>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource SurfaceInertBrush}"
                BorderBrush="{DynamicResource BorderHairlineBrush}" BorderThickness="0,1,0,0">
            <Grid>
                <DockPanel Margin="8,5,24,5">
                    <!-- Only a folder export is interruptible - it's the one operation that can run
                         for minutes writing gigabytes, and stopping it early still leaves everything
                         it already wrote on disk. -->
                    <Button DockPanel.Dock="Right" Content="Cancel" Style="{StaticResource DenseButton}" Margin="8,0,0,0"
                            Click="CancelExport_Click"
                            Visibility="{Binding IsExporting, Converter={StaticResource BoolToVis}}" />
                    <ComboBox x:Name="ThemePicker" DockPanel.Dock="Right" Width="110" Margin="12,0,0,0"
                              FontSize="{StaticResource FontSizeSecondary}" ItemStringFormat="{}{0} theme"
                              SelectionChanged="ThemePicker_SelectionChanged"
                              ToolTip="System follows the Windows app mode" />
                    <ProgressBar DockPanel.Dock="Right" Width="120" Height="12" IsIndeterminate="True"
                                 Visibility="{Binding Busy, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Text="{Binding Status}" TextTrimming="CharacterEllipsis" />
                </DockPanel>
                <ResizeGrip HorizontalAlignment="Right" VerticalAlignment="Bottom" />
            </Grid>
        </Border>

        <TabControl x:Name="MainTabs" Margin="8">

            <!-- ============================= MODS ============================= -->
            <TabItem Header="Mods">
                <DockPanel Margin="6">
                    <Border DockPanel.Dock="Bottom" Padding="0,10,0,0">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Deploy mods" Click="BuildAndApply_Click"
                                    Style="{StaticResource PrimaryButton}" />
                            <Button DockPanel.Dock="Right" Content="Revert to original" Click="RestoreVanilla_Click"
                                    Style="{StaticResource ToolbarButton}" Margin="0,0,16,0" />
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Import mod" Click="AddMod_Click" Style="{StaticResource ToolbarButton}" />
                                <Button Content="Import legacy mod" Click="ImportLegacy_Click" Style="{StaticResource ToolbarButton}" />
                                <Button Content="Apply .fc2model" Click="ApplyPack_Click" Style="{StaticResource ToolbarButton}"
                                        ToolTip="Encodes a model pack a 3D editor changed and stages the changed files into the workspace." />
                                <Button Content="Rescan mods" Click="RescanMods_Click" Style="{StaticResource ToolbarButton}"
                                        ToolTip="Re-reads every mod's zip and the workspace folder from disk - picks up a mod replaced or edited outside JackAll without needing a restart." />
                                <Button Content="Check for dead edits" Click="LintArchetypes_Click" Style="{StaticResource ToolbarButton}"
                                        ToolTip="Finds archetype edits a later entity library overrides, which change the file but nothing in game." />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <DockPanel DockPanel.Dock="Top" Style="{StaticResource TabToolbar}">
                        <TextBlock VerticalAlignment="Center" Style="{StaticResource Secondary}" TextWrapping="Wrap"
                                   Text="Mods are applied top to bottom - if two of them change the same file, the lower one wins. Workspace, the staging area for new mods, always goes last." />
                    </DockPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="300" />
                            <ColumnDefinition Width="{StaticResource SplitterSize}" />
                            <ColumnDefinition Width="320" MinWidth="240" />
                        </Grid.ColumnDefinitions>

                    <DataGrid x:Name="ModGrid" Grid.Column="0" ItemsSource="{Binding Mods}"
                              CanUserReorderColumns="False" CanUserSortColumns="False"
                              SelectionMode="Single" RowHeight="30"
                              SelectionChanged="ModGrid_SelectionChanged">
                        <DataGrid.Columns>
                            <!-- Reorder controls only make sense on the row currently selected, so they
                                 live in their own cell instead of the toolbar and stay hidden otherwise
                                 (and never show on the workspace row, which is pinned last). -->
                            <DataGridTemplateColumn Header="" Width="56" CanUserResize="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True" />
                                                                <Condition Binding="{Binding IsWorkspace}" Value="False" />
                                                                <Condition Binding="{Binding DataContext.HasMultipleMods, RelativeSource={RelativeSource AncestorType=DataGrid}}" Value="True" />
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <Button Content="&#9650;" Click="MoveUp_Click"
                                                    Padding="0" Width="22" Height="22" Margin="0,0,2,0" />
                                            <Button Content="&#9660;" Click="MoveDown_Click"
                                                    Padding="0" Width="22" Height="22" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Active" Width="50">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Mod" Binding="{Binding Name}" Width="*" />
                        </DataGrid.Columns>
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsWorkspace}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
                                        <Setter Property="FontStyle" Value="Italic" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                    </DataGrid>

                        <GridSplitter Grid.Column="1" />

                        <!-- ==================== Details sidebar: selected mod's files ==================== -->
                        <Border Grid.Column="2" Style="{StaticResource SidebarPane}">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="Select a mod to see its files." Style="{StaticResource EmptyHint}"
                                           Visibility="{Binding NoSelectedMod, Converter={StaticResource BoolToVis}}" />

                                <DockPanel DockPanel.Dock="Top" Visibility="{Binding HasSelectedMod, Converter={StaticResource BoolToVis}}">
                                    <TextBlock DockPanel.Dock="Top" Text="{Binding SelectedMod.Name}" Style="{StaticResource Heading}"
                                               Margin="0,0,0,4" />
                                    <TextBlock DockPanel.Dock="Top" Text="{Binding SelectedMod.FileCountText}" Style="{StaticResource Secondary}"
                                               Margin="0,0,0,8" />

                                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                                        <!-- A zip mod opens the folder it's sitting in; the workspace row opens
                                             the staging folder itself - same destination OpenWorkspace_Click
                                             used to go to before this button replaced it. -->
                                        <Button Content="Open location" Click="OpenModLocation_Click"
                                                Margin="0,0,6,0" />

                                        <!-- The workspace holds the user's own edits and can't be removed -
                                             see RemoveMod_Click's guard. -->
                                        <Button Content="Remove" Click="RemoveMod_Click">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedMod.IsWorkspace}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </StackPanel>

                                    <TreeView x:Name="ModFileTree" ItemsSource="{Binding SelectedModFiles}"
                                              ItemTemplate="{StaticResource ModFileTemplate}"
                                              BorderThickness="0" Background="Transparent">
                                        <TreeView.Resources>
                                            <!-- Declared here (not ItemContainerStyle) so it applies at every
                                                 depth - same single-click-to-toggle behavior as FolderTree,
                                                 reusing its handler since the logic doesn't depend on FolderNode. -->
                                            <Style TargetType="{x:Type TreeViewItem}" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                                                <EventSetter Event="PreviewMouseLeftButtonDown" Handler="FolderTree_ItemClicked" />
                                            </Style>
                                        </TreeView.Resources>
                                    </TreeView>
                                </DockPanel>
                            </DockPanel>
                        </Border>
                    </Grid>
                </DockPanel>
            </TabItem>

            <!-- ============================= SAVES ============================= -->
            <TabItem Header="Saves">
                <DockPanel Margin="6">
                    <DockPanel DockPanel.Dock="Top" Style="{StaticResource TabToolbar}">
                        <TextBlock Style="{StaticResource StatusText}" Text="{Binding SavesStatus}" />
                    </DockPanel>

                    <Border DockPanel.Dock="Top" Style="{StaticResource WarningCallout}" Margin="0,0,0,8">
                        <TextBlock TextWrapping="Wrap">
                            <Run FontWeight="Bold" Text="Mods and existing saves: " />
                            <Run Text="a save file persists values overlapping with almost every entity-library." />
                            <LineBreak />
                            <Run Text="This means .fcb files cannot override values already stored in the savegame." />
                            <LineBreak />
                            <Run Text="That's why modding requires the player to start a new game every time they install a mod that touches .fcb files." />
                        </TextBlock>
                    </Border>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="400" MinWidth="300" />
                            <ColumnDefinition Width="{StaticResource SplitterSize}" />
                            <ColumnDefinition Width="*" MinWidth="280" />
                        </Grid.ColumnDefinitions>

                        <!-- The list, as a table: column 1 is the same thumbnail+details view as
                             before (widest, expands), column 2 is the fixed-width "deploy" checkbox. -->
                        <DataGrid x:Name="SavesGrid" Grid.Column="0" ItemsSource="{Binding Saves}"
                                  SelectionChanged="SavesGrid_SelectionChanged"
                                  IsEnabled="{Binding SavesGridEnabled}" SelectionMode="Single" RowHeight="106">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Save" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="0,8">
                                                <Border Width="128" Height="90" Background="{DynamicResource WellBrush}"
                                                        BorderBrush="{DynamicResource BorderEmphasisBrush}" BorderThickness="1">
                                                    <Grid>
                                                        <Image Source="{Binding Thumbnail}" Stretch="Uniform"
                                                               Visibility="{Binding HasThumbnail, Converter={StaticResource BoolToVis}}" />
                                                        <TextBlock Text="no preview" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding HasThumbnail}" Value="False">
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Grid>
                                                </Border>
                                                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Style="{StaticResource Heading}">
                                                        <Run Text="{Binding PlayerName, Mode=OneWay}" />
                                                        <Run Text=" — " />
                                                        <Run Text="{Binding WorldName, Mode=OneWay}" />
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding FileName}" Style="{StaticResource GridMutedText}" Margin="0,2,0,4" />
                                                    <TextBlock Text="{Binding LastWriteTimeText}" Margin="0,0,0,2" />
                                                    <TextBlock Margin="0,0,0,2">
                                                        <Run Text="{Binding PersistedObjectCountText, Mode=OneWay}" />
                                                    </TextBlock>
                                                    <TextBlock Style="{StaticResource GridMutedText}">
                                                        <Run Text="DLC: " /><Run Text="{Binding DlcText, Mode=OneWay}" />
                                                    </TextBlock>
                                                </StackPanel>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <GridSplitter Grid.Column="1" />

                        <!-- ==================== Details sidebar ==================== -->
                        <Border Grid.Column="2" Style="{StaticResource SidebarPane}">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="Select a save to see its details." Style="{StaticResource EmptyHint}"
                                           Visibility="{Binding NoSelectedSave, Converter={StaticResource BoolToVis}}" />

                                <StackPanel DockPanel.Dock="Top" Visibility="{Binding HasSelectedSave, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{Binding SelectedSave.FileName}" Style="{StaticResource Heading}" Margin="0,0,0,8" />

                                    <!-- Every known header field - see reverse/dunia/savegame_format.md
                                         for what each one actually is. -->
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" MinWidth="90" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                                            <RowDefinition /><RowDefinition /><RowDefinition />
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="World" Style="{StaticResource Secondary}" />
                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedSave.WorldName}" TextWrapping="Wrap" />

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Player" Style="{StaticResource Secondary}" />
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedSave.PlayerName}" TextWrapping="Wrap" />

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Saved" Style="{StaticResource Secondary}" />
                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedSave.LastWriteTimeText}" TextWrapping="Wrap" />

                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Thumbnail" Style="{StaticResource Secondary}" />
                                        <TextBlock Grid.Row="3" Grid.Column="1" TextWrapping="Wrap">
                                            <Run Text="{Binding SelectedSave.Info.ThumbnailWidth, Mode=OneWay}" />
                                            <Run Text="×" />
                                            <Run Text="{Binding SelectedSave.Info.ThumbnailHeight, Mode=OneWay}" />
                                        </TextBlock>

                                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Persisted" Style="{StaticResource Secondary}" />
                                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SelectedSave.PersistedObjectCountText}" TextWrapping="Wrap" />

                                        <TextBlock Grid.Row="5" Grid.Column="0" Text="DLC" Style="{StaticResource Secondary}" />
                                        <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding SelectedSave.DlcText}" TextWrapping="Wrap" />

                                        <TextBlock Grid.Row="6" Grid.Column="0" Text="File" Style="{StaticResource Secondary}" />
                                        <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding SelectedSave.Info.FilePath}"
                                                   Style="{StaticResource Note}" />
                                    </Grid>

                                    <Separator Margin="0,0,0,10" />

                                    <TextBlock Text="{Binding SelectedSaveDetails.StatusText}" Style="{StaticResource Secondary}"
                                               TextWrapping="Wrap" Margin="0,0,0,8" />

                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <!-- Deletes the actual .sav file from disk - see DeleteSave_Click's
                                             confirmation prompt before this runs. -->
                                        <Button Content="Delete…" Margin="0,0,6,0"
                                                Click="DeleteSave_Click" IsEnabled="{Binding SavesGridEnabled}" />

                                        <!-- Writes a separate new save with this one's persisted entities dropped. -->
                                        <Button Content="Purge persisted entities…" Margin="0,0,6,0"
                                                Click="PurgeSave_Click" IsEnabled="{Binding SavesGridEnabled}" />

                                        <!-- Opens this save's PersistenceDB in the FCB document editor; see OpenSaveFcbEditorTab. -->
                                        <Button Content="Open value editor…"
                                                Click="OpenSaveFcbEditor_Click"
                                                Visibility="{Binding SelectedSaveDetails.ShowDocument, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </Grid>
                </DockPanel>
            </TabItem>

            <!-- ============================= FILES ============================= -->
            <TabItem Header="Files" x:Name="FilesTabItem">
                <DockPanel Margin="6">
                    <DockPanel DockPanel.Dock="Top" Style="{StaticResource TabToolbar}">
                        <CheckBox DockPanel.Dock="Left" Margin="0,0,16,0" Content="Show only mod files"
                                  IsChecked="{Binding OnlyMods}" VerticalAlignment="Center" />
                        <CheckBox DockPanel.Dock="Left" Margin="0,0,16,0" Content="Hide unused game files"
                                  IsChecked="{Binding HideUnused}" VerticalAlignment="Center"
                                  ToolTip="Hides base game files the engine can never open - authoring twins, console leftovers, and the un-stripped development world. Your own edits are never hidden." />
                        <TextBlock DockPanel.Dock="Left" Text="Filter:" Style="{StaticResource ToolbarLabel}" />
                        <TextBox Style="{StaticResource SearchBox}" VerticalAlignment="Center"
                                 Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}">
                            <TextBox.Tag>
                                <TextBlock>
                                    <Run Text="Matches any word - narrow with " />
                                    <Run Text="ext:&lt;type&gt;" FontStyle="Normal" FontFamily="{StaticResource MonoFont}" />
                                    <Run Text=", " />
                                    <Run Text="arch:&lt;module&gt;" FontStyle="Normal" FontFamily="{StaticResource MonoFont}" />
                                    <Run Text=", " />
                                    <Run Text="hash:&lt;hex&gt;" FontStyle="Normal" FontFamily="{StaticResource MonoFont}" />
                                </TextBlock>
                            </TextBox.Tag>
                        </TextBox>
                    </DockPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="230" MinWidth="160" />
                        <ColumnDefinition Width="{StaticResource SplitterSize}" />
                        <ColumnDefinition Width="630" MinWidth="300" />
                        <ColumnDefinition Width="{StaticResource SplitterSize}" />
                        <ColumnDefinition Width="*" MinWidth="230" />
                    </Grid.ColumnDefinitions>

                    <!-- Virtualized: the merged view is >150,000 files. -->
                    <TreeView x:Name="FolderTree" Grid.Column="0"
                              ItemsSource="{Binding Roots}"
                              ItemTemplate="{StaticResource FolderTemplate}"
                              SelectedItemChanged="FolderTree_SelectedItemChanged"
                              VirtualizingStackPanel.IsVirtualizing="True"
                              VirtualizingStackPanel.VirtualizationMode="Recycling"
                              ScrollViewer.CanContentScroll="True">
                        <!-- One menu for the whole tree, not one per row: a ContextMenu is a single
                             element with a single logical parent, so putting it in the TreeViewItem
                             style below would hand the same instance to every row and throw the
                             moment a second one was realized. It acts on the selected folder, which
                             right-clicking a row has just made the row under the cursor (see
                             FolderTree_ItemRightClicked). -->
                        <TreeView.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Export folder…" Click="ExportFolder_Click" />
                            </ContextMenu>
                        </TreeView.ContextMenu>
                        <TreeView.Resources>
                            <!--
                                Declared here rather than as TreeView.ItemContainerStyle so it applies
                                at every depth, not just the roots.

                                A single click anywhere on the row expands or collapses the folder, the
                                way VS Code's explorer does — hunting for the chevron is a needless
                                precision task when the whole row is a valid target. The default
                                expander triangle is dropped from the template below, since the folder
                                emoji already marks a row as expandable and the triangle duplicated it.
                            -->
                            <Style TargetType="{x:Type TreeViewItem}" BasedOn="{StaticResource StateTreeItem}">
                                <EventSetter Event="PreviewMouseLeftButtonDown" Handler="FolderTree_ItemClicked" />
                                <!-- Right-click selects the row before its menu opens, so the menu (and
                                     the details pane, and the file list) all act on the folder actually
                                     under the cursor - WPF's TreeView doesn't select on right-click by
                                     itself, which would otherwise export whatever was selected before. -->
                                <EventSetter Event="PreviewMouseRightButtonDown" Handler="FolderTree_ItemRightClicked" />
                                <Setter Property="Padding" Value="2" />
                                <!-- Round-trips expand/collapse to FolderNode.IsExpanded, so a tree
                                     rebuild (every edit rebuilds it from scratch) can restore what was
                                     open instead of collapsing everything back down. -->
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                <Setter Property="local:ItemState.IsChanged" Value="{Binding ContainsMods}" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="{x:Type TreeViewItem}">
                                            <StackPanel>
                                                <Border x:Name="Bd"
                                                        Padding="{TemplateBinding Padding}"
                                                        Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        SnapsToDevicePixels="True">
                                                    <ContentPresenter x:Name="PART_Header"
                                                                      ContentSource="Header"
                                                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                                                </Border>
                                                <ItemsPresenter x:Name="ItemsHost" Margin="19,0,0,0" Visibility="Collapsed" />
                                            </StackPanel>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsExpanded" Value="True">
                                                    <Setter TargetName="ItemsHost" Property="Visibility" Value="Visible" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd" Property="Background"
                                                            Value="{DynamicResource SelectionInactiveBrush}" />
                                                </Trigger>
                                                <MultiTrigger>
                                                    <MultiTrigger.Conditions>
                                                        <Condition Property="IsSelected" Value="True" />
                                                        <Condition Property="Selector.IsSelectionActive" Value="True" />
                                                    </MultiTrigger.Conditions>
                                                    <Setter TargetName="Bd" Property="Background"
                                                            Value="{DynamicResource SelectionBrush}" />
                                                </MultiTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </TreeView.Resources>
                    </TreeView>

                    <GridSplitter Grid.Column="1" />

                    <DockPanel Grid.Column="2" Margin="6,0">
                        <DataGrid x:Name="FileGrid" ItemsSource="{Binding VisibleFiles}"
                                  SelectionChanged="FileGrid_SelectionChanged"
                                  SelectionMode="Extended" EnableColumnVirtualization="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Name" Binding="{Binding FileName}" Width="*" />
                                <DataGridTextColumn Header="Size" Binding="{Binding Size, StringFormat={}{0:N0}}" Width="80" />
                                <DataGridTextColumn Header="Source" Width="110">
                                    <!-- Disambiguates a colliding archive name with its parent folder
                                         (e.g. "dlc1/menus") - see ModuleNameMultiConverter. -->
                                    <DataGridTextColumn.Binding>
                                        <MultiBinding Converter="{StaticResource ModuleNameConverter}">
                                            <Binding />
                                            <Binding Path="DataContext" RelativeSource="{RelativeSource AncestorType=DataGrid}" />
                                        </MultiBinding>
                                    </DataGridTextColumn.Binding>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow" BasedOn="{StaticResource StateGridRow}">
                                    <Setter Property="local:ItemState.IsChanged" Value="{Binding IsModded}" />
                                    <Style.Triggers>
                                        <!-- Italic rather than another Foreground: grey/black already
                                             means "untouched/changed", and a dead file can be either. -->
                                        <DataTrigger Binding="{Binding Converter={StaticResource UnusedFileConverter}}" Value="True">
                                            <Setter Property="FontStyle" Value="Italic" />
                                            <Setter Property="ToolTip" Value="The game never reads this file - editing it will have no effect." />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                        </DataGrid>
                    </DockPanel>

                    <GridSplitter Grid.Column="3" />

                    <Border Grid.Column="4" Style="{StaticResource SidebarPane}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Note}" Margin="0,10,0,0"
                                       Text="Replacing a file stages it in your workspace. Nothing reaches the game until you press Deploy mods on the Mods tab." />

                            <!-- Docked below the preview rather than inside it: references are worth
                                 showing for every selected file, including the ~25% whose type has no
                                 handler at all (see XrefPanel's remarks). Filled in by
                                 MainWindow.xaml.cs's RefreshPreview. -->
                            <xrefs:XrefPanel x:Name="XrefsPanel" DockPanel.Dock="Bottom"
                                             Visibility="Collapsed" Margin="0,10,0,0" />

                            <!-- Browsing to a folder leaves the grid with nothing selected, so this is
                                 where the folder you're standing in gets its own actions rather than
                                 dead space. -->
                            <StackPanel DockPanel.Dock="Top"
                                        Visibility="{Binding NoSelection, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Select a file or folder to see its details." Style="{StaticResource EmptyHint}"
                                           Visibility="{Binding NoSelectedFolder, Converter={StaticResource BoolToVis}}" />

                                <StackPanel Visibility="{Binding HasSelectedFolder, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{Binding SelectedFolder.Name}" Style="{StaticResource Heading}" Margin="0,0,0,8" />
                                    <TextBlock Text="{Binding SelectedFolder.FullPath}" TextWrapping="Wrap"
                                               Margin="0,0,0,12" />
                                    <Button Content="Export folder…" Click="ExportFolder_Click"
                                            HorizontalAlignment="Left" />
                                    <TextBlock Style="{StaticResource Note}" Margin="0,8,0,0"
                                               Text="Writes every file at or below this folder to disk, keeping the folder structure. Honours the 'only mod files' switch, but not the search box." />
                                </StackPanel>
                            </StackPanel>

                            <StackPanel DockPanel.Dock="Top" Visibility="{Binding IsMultiSelection, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding MultiSelectCountText}" Style="{StaticResource Heading}" Margin="0,0,0,8" />
                                <TextBlock Text="{Binding MultiSelectSizeText}" Margin="0,0,0,12" />
                                <Button Content="Export all…" Click="ExportAll_Click"
                                        HorizontalAlignment="Left" />
                            </StackPanel>

                            <StackPanel DockPanel.Dock="Top" Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding SelectedFile.FileName}" Style="{StaticResource Heading}" Margin="0,0,0,8" />

                                <TextBlock TextWrapping="Wrap" Margin="0,0,0,6">
                                    <Run Text="{Binding SizeText, Mode=OneWay}" /><Run Text="  •  " /><Run Text="{Binding OriginText, Mode=OneWay}" />
                                </TextBlock>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="{Binding HashText}" VerticalAlignment="Center"
                                               Style="{StaticResource Mono}" TextTrimming="CharacterEllipsis" />
                                    <Button Content="Copy" Click="CopyHash_Click" Style="{StaticResource DenseButton}" Margin="6,0,0,0" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="{Binding PathText}" VerticalAlignment="Top" TextWrapping="Wrap" />
                                    <Button Content="Copy" Click="CopyPath_Click" Style="{StaticResource DenseButton}" Margin="6,0,0,0"
                                            VerticalAlignment="Top" />
                                </StackPanel>

                                <TextBlock Text="{Binding ModOrigin}" TextWrapping="Wrap" Margin="0,0,0,6"
                                           Visibility="{Binding CanRevert, Converter={StaticResource BoolToVis}}" />

                                <TextBlock Text="{Binding NamingNote}" Style="{StaticResource Note}" Margin="0,0,0,6"
                                           Visibility="{Binding HasNamingNote, Converter={StaticResource BoolToVis}}" />

                                <TextBlock Text="{Binding AncestryText}" Style="{StaticResource Note}" Margin="0,0,0,6"
                                           Visibility="{Binding HasAncestry, Converter={StaticResource BoolToVis}}" />

                                <!-- Same weight as the reach note below: both are cases where an edit
                                     looks staged and does nothing in game. -->
                                <Border Style="{StaticResource WarningCallout}" Margin="0,0,0,6"
                                        Visibility="{Binding HasLayerMismatchNote, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{Binding LayerMismatchNote}" TextWrapping="Wrap" />
                                </Border>

                                <!-- Louder than NamingNote above on purpose: an unknown name is a
                                     curiosity, a dead file is an evening about to be wasted. -->
                                <Border Style="{StaticResource WarningCallout}" Margin="0,0,0,6"
                                        Visibility="{Binding HasReachNote, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{Binding ReachNote}" TextWrapping="Wrap" />
                                </Border>

                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Content="Export…" Click="Export_Click" Margin="0,0,6,0" />
                                    <Button Content="Export original…" Click="ExportOriginal_Click" Margin="0,0,6,0"
                                            Visibility="{Binding HasOriginal, Converter={StaticResource BoolToVis}}" />
                                    <Button Content="Replace…" Click="Replace_Click" Margin="0,0,6,0" />
                                    <Button Content="Revert" Click="Revert_Click"
                                            Visibility="{Binding CanRevertFromWorkspace, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>

                                <!-- Same content Export/Export original would write to a file, but staged
                                     straight into the workspace instead - a shortcut for "pin this exact
                                     version so it wins over everything below it" without a round trip
                                     through the filesystem. -->
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <Button Content="Mirror…" Click="Mirror_Click" Margin="0,0,6,0"
                                            ToolTip="Copy the asset while keeping the folder structure" />
                                    <Button Content="Mirror original…" Click="MirrorOriginal_Click"
                                            Visibility="{Binding HasOriginal, Converter={StaticResource BoolToVis}}"
                                            ToolTip="Copy the asset while keeping the folder structure" />
                                </StackPanel>

                                <!-- A model and everything it names, decoded into one pack a 3D editor
                                     can open without a line of Dunia format code. Applying one stages
                                     the entries an editor changed back into the workspace. -->
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0"
                                            Visibility="{Binding SelectionIsModel, Converter={StaticResource BoolToVis}}">
                                    <Button Content="Export as .fc2model…" Click="ExportPack_Click" Margin="0,0,6,0"
                                            ToolTip="Collect this model, its materials, textures and rig into one decoded pack" />
                                    <Button Content="…with animations" Click="ExportPackWithClips_Click"
                                            ToolTip="Also carry every animation bank that names this model" />
                                </StackPanel>
                            </StackPanel>

                            <!-- Filled in by MainWindow.xaml.cs — FileHandlerCatalog picks the view for the selected file's type. -->
                            <Grid Margin="0,10,0,0">
                                <ContentControl x:Name="PreviewHost" Visibility="Collapsed" />

                                <!-- Shown instead of PreviewHost when the file's type has no handler. -->
                                <Border x:Name="NoPreviewPanel" Visibility="Collapsed" Style="{StaticResource InertFrame}" Padding="16">
                                    <TextBlock Text="No preview available for this file type." Style="{StaticResource Secondary}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               TextAlignment="Center" TextWrapping="Wrap" />
                                </Border>
                            </Grid>
                        </DockPanel>
                    </Border>
                    </Grid>
                </DockPanel>
            </TabItem>

            <!-- ============================= MAP ============================== -->
            <TabItem Header="Map">
                <mapEditor:MapTabView x:Name="MapTab" Margin="6" />
            </TabItem>

            <!-- =========================== ARCHETYPES =========================== -->
            <TabItem Header="Archetypes" x:Name="LibraryTabItem">
                <library:LibraryTabView x:Name="LibraryTab" Margin="6" />
            </TabItem>

            <!-- ========================== MOVE GRAPHS ========================== -->
            <TabItem Header="Animations" x:Name="MoveTabItem">
                <move:MoveTabView x:Name="MoveTab" Margin="6" />
            </TabItem>

            <!-- Document tabs open after this; shown only while one is (see EditorTabs). -->
            <TabItem x:Name="DocumentDivider" Style="{StaticResource TabDivider}" Visibility="Collapsed" />
        </TabControl>
    </DockPanel>
</Window>
