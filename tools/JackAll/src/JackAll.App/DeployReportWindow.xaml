<Window x:Class="JackAll.App.DeployReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="760" Height="480" MinWidth="420" MinHeight="260" ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextPrimaryBrush}">
    <DockPanel Margin="12">
        <TextBlock x:Name="HeadingText" DockPanel.Dock="Top" Style="{StaticResource Heading}" Margin="0,0,0,10" />
        <Button DockPanel.Dock="Bottom" HorizontalAlignment="Right" Margin="0,12,0,0" Content="OK"
                Style="{StaticResource PrimaryButton}" MinWidth="80" IsDefault="True" IsCancel="True"
                AutomationProperties.AutomationId="DeployReportOk" />
        <TextBox x:Name="ReportText" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                 VerticalContentAlignment="Stretch" Padding="8" AutomationProperties.AutomationId="DeployReportText" />
    </DockPanel>
</Window>
