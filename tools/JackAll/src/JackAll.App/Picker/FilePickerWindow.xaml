<Window x:Class="JackAll.App.Picker.FilePickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:JackAll.App"
        Title="{Binding Title}" Width="1000" Height="640" MinWidth="720" MinHeight="400"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextPrimaryBrush}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <DockPanel Margin="10">
        <DockPanel DockPanel.Dock="Top" Style="{StaticResource TabToolbar}">
            <CheckBox DockPanel.Dock="Right" Margin="16,0,0,0" VerticalAlignment="Center"
                      Content="{Binding OnlyExtensionLabel}" IsChecked="{Binding OnlyExtension}"
                      Visibility="{Binding HasExtension, Converter={StaticResource BoolToVis}}"
                      AutomationProperties.AutomationId="FilePickerOnlyExtension" />
            <TextBox x:Name="SearchBox" Style="{StaticResource SearchBox}" VerticalAlignment="Center"
                     Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged, Delay=250}"
                     AutomationProperties.AutomationId="FilePickerSearch">
                <TextBox.Tag>
                    <TextBlock>
                        <Run Text="Search every folder - narrow with " />
                        <Run Text="ext:&lt;type&gt;" FontStyle="Normal" FontFamily="{StaticResource MonoFont}" />
                        <Run Text=", " />
                        <Run Text="arch:&lt;module&gt;" FontStyle="Normal" FontFamily="{StaticResource MonoFont}" />
                        <Run Text=", " />
                        <Run Text="hash:&lt;hex&gt;" FontStyle="Normal" FontFamily="{StaticResource MonoFont}" />
                    </TextBlock>
                </TextBox.Tag>
            </TextBox>
        </DockPanel>

        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <Button DockPanel.Dock="Right" Content="Cancel" IsCancel="True" Margin="6,0,0,0" MinWidth="80"
                    AutomationProperties.AutomationId="FilePickerCancel" />
            <Button DockPanel.Dock="Right" Content="OK" Style="{StaticResource PrimaryButton}" MinWidth="80"
                    IsEnabled="{Binding CanAccept}" Click="Ok_Click"
                    AutomationProperties.AutomationId="FilePickerOk" />
            <TextBlock DockPanel.Dock="Left" Text="File name:" Style="{StaticResource ToolbarLabel}" />
            <TextBlock DockPanel.Dock="Right" Text="{Binding Status}" Style="{StaticResource MonoNote}"
                       VerticalAlignment="Center" Margin="8,0,12,0" />
            <TextBox Text="{Binding FileName, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource MonoFont}"
                     VerticalAlignment="Center" KeyDown="Accept_KeyDown" AutomationProperties.AutomationId="FilePickerFileName" />
        </DockPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" MinWidth="160" />
                <ColumnDefinition Width="{StaticResource SplitterSize}" />
                <ColumnDefinition Width="*" MinWidth="300" />
            </Grid.ColumnDefinitions>

            <TreeView x:Name="FolderTree" ItemsSource="{Binding Roots}" ItemTemplate="{StaticResource FolderTemplate}"
                      SelectedItemChanged="FolderTree_SelectedItemChanged"
                      VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling"
                      ScrollViewer.CanContentScroll="True" AutomationProperties.AutomationId="FilePickerTree">
                <TreeView.Resources>
                    <Style TargetType="{x:Type TreeViewItem}" BasedOn="{StaticResource FolderTreeItem}">
                        <EventSetter Event="PreviewMouseLeftButtonDown" Handler="FolderTree_ItemClicked" />
                    </Style>
                </TreeView.Resources>
            </TreeView>

            <GridSplitter Grid.Column="1" />

            <DataGrid x:Name="FileGrid" Grid.Column="2" Margin="6,0,0,0" ItemsSource="{Binding Files}"
                      SelectedItem="{Binding SelectedFile}" SelectionMode="Single" EnableColumnVirtualization="True"
                      PreviewKeyDown="Accept_KeyDown" AutomationProperties.AutomationId="FilePickerGrid">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Name" Binding="{Binding FileName}" Width="*" />
                    <DataGridTextColumn Header="Size" Binding="{Binding Size, StringFormat={}{0:N0}}" Width="80" />
                    <DataGridTextColumn Header="Folder" Binding="{Binding Directory}" Width="260" />
                </DataGrid.Columns>
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow" BasedOn="{StaticResource StateGridRow}">
                        <Setter Property="local:ItemState.IsChanged" Value="{Binding IsModded}" />
                        <EventSetter Event="MouseDoubleClick" Handler="Row_DoubleClick" />
                    </Style>
                </DataGrid.RowStyle>
            </DataGrid>
        </Grid>
    </DockPanel>
</Window>
