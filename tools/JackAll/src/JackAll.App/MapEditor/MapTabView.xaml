<UserControl x:Class="JackAll.App.MapEditor.MapTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:glWpf="clr-namespace:OpenTK.Wpf;assembly=GLWpfControl">

    <DockPanel>
        <!-- Save/Deploy stay disabled until an editing phase lands; only world load works. -->
        <Border DockPanel.Dock="Top" Padding="0,0,0,6">
            <DockPanel>
                <TextBlock x:Name="StatusText" DockPanel.Dock="Right" VerticalAlignment="Center"
                           Foreground="#555" Text="Waiting for the game archives to load" />
                <StackPanel Orientation="Horizontal">
                    <ComboBox x:Name="MapPicker" Width="190" IsEnabled="False" Margin="0,0,8,0"
                              DisplayMemberPath="Name"
                              ToolTip="Every map that ships terrain: the two campaign worlds, the multiplayer maps, and tmpla" />
                    <Button x:Name="LoadButton" Content="Load" IsEnabled="False" Padding="12,3" Margin="0,0,4,0"
                            Click="Load_Click" />
                    <Button Content="Save" IsEnabled="False" Padding="12,3" Margin="0,0,4,0" />
                    <Button Content="Deploy" IsEnabled="False" Padding="12,3" />
                    <CheckBox x:Name="GroundCollision" Content="Ground collision" IsChecked="True"
                              VerticalAlignment="Center" Margin="12,0,0,0"
                              ToolTip="Slows the camera to a stop as it approaches the terrain instead of flying through it" />
                    <CheckBox x:Name="Atmosphere" Content="Haze" IsChecked="True"
                              VerticalAlignment="Center" Margin="10,0,0,0"
                              ToolTip="Dusty distance fog fading to the sky's horizon colour; off to see the whole map clearly" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180" MinWidth="140" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="300" MinWidth="220" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="*" MinWidth="300" />
            </Grid.ColumnDefinitions>

            <!-- Layer list: the checkbox is the planned viewport-overlay toggle, selection picks
                 which editing panel shows in the middle column. -->
            <DockPanel Grid.Column="0">
            <Button DockPanel.Dock="Top" Content="Uncheck all" Padding="0,3" Margin="0,0,0,4"
                    Click="UncheckAll_Click"
                    ToolTip="Hides every layer except the heightmap" />
            <ListBox x:Name="LayerList" SelectionChanged="LayerList_SelectionChanged"
                     BorderThickness="1" BorderBrush="#DDD">
                <ListBox.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" FontSize="10" FontWeight="SemiBold"
                                           Foreground="#888" Margin="4,8,0,2" />
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </ListBox.GroupStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <CheckBox IsChecked="{Binding IsVisible}" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            </DockPanel>

            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="Transparent" />

            <!-- Context panel: swaps per selected layer; the mock shows what each panel will hold. -->
            <Border Grid.Column="2" BorderThickness="1" BorderBrush="#DDD" Padding="10,8">
                <Grid>
                <!-- Entities get a real panel rather than the mock: a searchable list over a
                     read-only field view. It sits outside the scroll viewer so the list virtualizes. -->
                <DockPanel x:Name="EntityPanel" Visibility="Collapsed">
                    <TextBox x:Name="EntitySearch" DockPanel.Dock="Top" Margin="0,0,0,6"
                             TextChanged="EntitySearch_TextChanged"
                             ToolTip="Filters by name or archetype" />
                    <TextBlock x:Name="EntityCount" DockPanel.Dock="Top" Foreground="#888" Margin="0,0,0,4" />
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" MinHeight="80" />
                            <RowDefinition Height="4" />
                            <RowDefinition Height="180" MinHeight="60" />
                        </Grid.RowDefinitions>
                        <ListBox x:Name="EntityList" Grid.Row="0" SelectionChanged="EntityList_SelectionChanged"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding ArchetypeName}" FontSize="10" Foreground="#888"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <GridSplitter Grid.Row="1" HorizontalAlignment="Stretch" Background="Transparent" />
                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock x:Name="EntityHeading" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <ItemsControl x:Name="EntityFields" Margin="0,4,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel Margin="0,0,0,2">
                                                <TextBlock DockPanel.Dock="Left" Text="{Binding Name}" Width="110"
                                                           Foreground="#666" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Value}" FontFamily="Consolas" FontSize="11"
                                                           TextWrapping="Wrap" />
                                            </DockPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </DockPanel>

                <!-- Mission layers filter which entities are drawn and listed. -->
                <DockPanel x:Name="MissionLayerPanel" Visibility="Collapsed">
                    <TextBlock DockPanel.Dock="Top" Foreground="#888" TextWrapping="Wrap" Margin="0,0,0,6"
                               Text="Each sector scopes its entities into layers. Unticking one hides its entities everywhere." />
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                        <Button Content="All" Click="MissionLayersAll_Click" Padding="10,2" Margin="0,0,4,0" />
                        <Button Content="Only main" Click="MissionLayersMain_Click" Padding="10,2" />
                    </DockPanel>
                    <ListBox x:Name="MissionLayerList" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,1">
                                    <CheckBox DockPanel.Dock="Left" IsChecked="{Binding IsVisible}"
                                              Click="MissionLayerToggle_Click" Margin="0,0,6,0" />
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Count}" Foreground="#888"
                                               Margin="6,0,0,0" />
                                    <TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>

                <ScrollViewer x:Name="ContextInfo" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock x:Name="ContextTitle" FontSize="14" FontWeight="SemiBold" />
                        <TextBlock x:Name="ContextReadiness" FontSize="10" Foreground="#888" Margin="0,1,0,0" />
                        <TextBlock x:Name="ContextSummary" TextWrapping="Wrap" Foreground="#555" Margin="0,8,0,0" />
                        <TextBlock Text="PLANNED CONTROLS" FontSize="9" FontWeight="SemiBold"
                                   Foreground="#888" Margin="0,14,0,4" />
                        <ItemsControl x:Name="ContextControls">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,3">
                                        <Run Text="- " /><Run Text="{Binding Mode=OneWay}" />
                                    </TextBlock>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- How an atlas texel maps onto a sector cell could not be settled from the
                             shipped data, so it is a toggle until a look at real terrain decides it. -->
                        <StackPanel x:Name="TexturePanel" Visibility="Collapsed">
                            <TextBlock Text="BRIGHTNESS" FontSize="9" FontWeight="SemiBold"
                                       Foreground="#888" Margin="0,14,0,4" />
                            <Slider x:Name="BrightnessSlider" Minimum="0.5" Maximum="3" Value="1.5"
                                    TickFrequency="0.25" IsSnapToTickEnabled="False"
                                    ToolTip="Exposure applied after the baked shadow and sun, which only ever darken" />
                            <TextBlock Foreground="#888" FontSize="11"
                                       Text="{Binding Value, ElementName=BrightnessSlider, StringFormat={}{0:0.00}x}" />
                            <TextBlock x:Name="TextureStatus" Foreground="#888" TextWrapping="Wrap" Margin="0,12,0,0" />
                        </StackPanel>

                        <StackPanel x:Name="TriggerPanel" Visibility="Collapsed">
                            <TextBlock x:Name="TriggerStatus" Foreground="#888" TextWrapping="Wrap" Margin="0,12,0,0" />
                        </StackPanel>

                        <StackPanel x:Name="LightPanel" Visibility="Collapsed">
                            <TextBlock x:Name="LightStatus" Foreground="#888" TextWrapping="Wrap" Margin="0,12,0,0" />
                        </StackPanel>

                        <StackPanel x:Name="SurfaceLegend" Visibility="Collapsed">
                            <TextBlock Text="SURFACE TYPES" FontSize="9" FontWeight="SemiBold"
                                       Foreground="#888" Margin="0,14,0,4" />
                            <ItemsControl x:Name="SurfaceLegendRows">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,0,0,3">
                                            <Border Width="11" Height="11" DockPanel.Dock="Left" Margin="0,0,6,0"
                                                    VerticalAlignment="Center" BorderBrush="#999" BorderThickness="1"
                                                    Background="{Binding Swatch}" />
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Coverage}"
                                                       Foreground="#888" Margin="6,0,0,0" />
                                            <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="3" HorizontalAlignment="Stretch" Background="Transparent" />

            <Grid Grid.Column="4">
                <glWpf:GLWpfControl x:Name="Viewport" Focusable="True"
                                    Render="Viewport_Render"
                                    MouseDown="Viewport_MouseDown" MouseUp="Viewport_MouseUp"
                                    MouseMove="Viewport_MouseMove" MouseWheel="Viewport_MouseWheel" />
                <Border VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,6,8,0"
                        Background="#66000000" Padding="6,2" CornerRadius="3" IsHitTestVisible="False">
                    <TextBlock x:Name="FpsText" Foreground="#CFC" FontFamily="Consolas" FontSize="11" />
                </Border>

                <StackPanel x:Name="ViewportHint" VerticalAlignment="Center" HorizontalAlignment="Center"
                            IsHitTestVisible="False">
                    <TextBlock Text="3D viewport" FontSize="16" Foreground="#666" HorizontalAlignment="Center" />
                    <TextBlock Text="Load a world to see its terrain" FontSize="11" Foreground="#888"
                               HorizontalAlignment="Center" Margin="0,4,0,0" />
                    <TextBlock Text="Right-drag look - WASD move, Q/E down/up - Shift to sprint - wheel changes speed"
                               FontSize="11" Foreground="#888" HorizontalAlignment="Center" Margin="0,2,0,0" />
                </StackPanel>
            </Grid>
        </Grid>
    </DockPanel>
</UserControl>
