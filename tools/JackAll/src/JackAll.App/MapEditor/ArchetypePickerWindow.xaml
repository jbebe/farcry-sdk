<Window x:Class="JackAll.App.MapEditor.ArchetypePickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="New entity from archetype" Width="560" Height="560" MinWidth="360" MinHeight="300"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextPrimaryBrush}">
    <DockPanel Margin="10">
        <TextBox x:Name="SearchBox" DockPanel.Dock="Top" Margin="0,0,0,6" Style="{StaticResource SearchBox}"
                 Tag="Search archetypes by full name…" PreviewKeyDown="Search_PreviewKeyDown"
                 Text="{Binding Search, UpdateSourceTrigger=PropertyChanged, Delay=250}"
                 AutomationProperties.AutomationId="ArchetypePickerSearch" />

        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <Button DockPanel.Dock="Right" Content="Cancel" IsCancel="True" Margin="6,0,0,0" MinWidth="80"
                    AutomationProperties.AutomationId="ArchetypePickerCancel" />
            <Button x:Name="OkButton" DockPanel.Dock="Right" Content="OK" Style="{StaticResource PrimaryButton}" MinWidth="80"
                    IsEnabled="False" Click="Ok_Click" AutomationProperties.AutomationId="ArchetypePickerOk" />
            <TextBlock Style="{StaticResource Muted}" VerticalAlignment="Center" Text="{Binding CountText}" />
        </DockPanel>

        <ListBox x:Name="Items" ItemsSource="{Binding Items}" DisplayMemberPath="FullName"
                 VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling"
                 SelectionChanged="Items_SelectionChanged" MouseDoubleClick="Items_MouseDoubleClick"
                 PreviewKeyDown="Items_PreviewKeyDown" AutomationProperties.AutomationId="ArchetypePickerList" />
    </DockPanel>
</Window>
