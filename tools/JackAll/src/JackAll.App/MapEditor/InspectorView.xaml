<UserControl x:Class="JackAll.App.MapEditor.InspectorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fcbEditor="clr-namespace:JackAll.App.FileHandlers.Fcb.FcbEditor"
             xmlns:mapEditor="clr-namespace:JackAll.App.MapEditor">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <fcbEditor:PropertyEditorTemplates />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="Visible" />

            <!-- Inherited rows are greyed; an override is marked on the left and can be reverted. -->
            <DataTemplate DataType="{x:Type mapEditor:InspectorField}">
                <Border BorderThickness="3,0,0,0" Padding="4,1,0,1" Margin="0,0,0,1">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="BorderBrush" Value="Transparent" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Origin}" Value="Inherited">
                                    <Setter Property="Opacity" Value="0.55" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Origin}" Value="Overridden">
                                    <Setter Property="BorderBrush" Value="#E08A00" />
                                    <Setter Property="Background" Value="#FFF6D6" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Revert" Padding="5,0" Margin="6,0,0,0"
                                VerticalAlignment="Center" Click="Revert_Click"
                                Visibility="{Binding CanRevert, Converter={StaticResource Visible}}"
                                ToolTip="Removes this override from the instance, so the archetype's value applies again" />
                        <TextBlock DockPanel.Dock="Left" Width="120" Text="{Binding Row.DisplayName}"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Row.Type}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Origin}" Value="Overridden">
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <ContentControl Content="{Binding Row.Editor}" VerticalAlignment="Center" />
                    </DockPanel>
                </Border>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
            <TextBlock Text="Select an entity in the hierarchy or the viewport." Foreground="#888" TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasEntity}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <StackPanel Visibility="{Binding HasEntity, Converter={StaticResource Visible}}">
                <TextBlock Text="{Binding Heading}" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Details}" Foreground="#777" TextWrapping="Wrap" Margin="0,2,0,0" />
                <WrapPanel Margin="0,6,0,4">
                    <Button Content="Archetype in Library" Padding="7,2" Margin="0,0,6,4" IsEnabled="{Binding CanShowArchetype}"
                            Click="ShowArchetype_Click"
                            ToolTip="Opens the Library tab on the archetype this entity merges over" />
                    <Button Content="Open in XML editor" Padding="7,2" Margin="0,0,6,4" IsEnabled="{Binding CanOpenSector}"
                            Click="OpenSector_Click"
                            ToolTip="Opens this entity's own fragment of its sector file. Not for an unsaved addition, which has no fragment yet." />
                    <Button Content="Copy" Padding="7,2" Margin="0,0,6,4" Click="Copy_Click"
                            ToolTip="Ctrl+C. Holds this entity for Ctrl+V in the viewport" />
                    <Button Content="Delete" Padding="7,2" Margin="0,0,6,4" Click="Delete_Click"
                            ToolTip="Del. Removes the selected entities on the next Save" />
                </WrapPanel>

                <TextBlock Text="TRANSFORM" FontSize="9" FontWeight="SemiBold" Foreground="#888" Margin="0,4,0,2" />
                <ItemsControl ItemsSource="{Binding Transform}" />

                <ItemsControl ItemsSource="{Binding Sections}" Margin="0,8,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type mapEditor:InspectorSection}">
                            <Expander Header="{Binding Title}" IsExpanded="{Binding IsExpanded}" Margin="{Binding Indent}">
                                <ItemsControl ItemsSource="{Binding Fields}" Margin="14,2,0,4" />
                            </Expander>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
