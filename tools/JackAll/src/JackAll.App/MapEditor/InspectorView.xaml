<UserControl x:Class="JackAll.App.MapEditor.InspectorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fcbEditor="clr-namespace:JackAll.App.FileHandlers.Fcb.FcbEditor">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <fcbEditor:PropertyEditorTemplates />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="Visible" />
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
            <TextBlock Text="Select an entity in the hierarchy or the viewport.">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource EmptyHint}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasEntity}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <StackPanel Visibility="{Binding HasEntity, Converter={StaticResource Visible}}">
                <TextBlock Text="{Binding Heading}" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Details}" Foreground="#777" TextWrapping="Wrap" Margin="0,2,0,0" />
                <WrapPanel Margin="0,6,0,4">
                    <Button Content="Open archetype" Padding="7,2" Margin="0,0,6,4" IsEnabled="{Binding CanShowArchetype}"
                            Click="ShowArchetype_Click"
                            ToolTip="Opens the Archetypes tab on the archetype this entity merges over" />
                    <Button Content="Open in FCB editor" Padding="7,2" Margin="0,0,6,4" IsEnabled="{Binding CanOpenSector}"
                            Click="OpenSector_Click"
                            ToolTip="Opens this entity's own fragment of its sector file. Not for an unsaved addition, which has no fragment yet." />
                    <Button Content="Copy" Padding="7,2" Margin="0,0,6,4" Click="Copy_Click"
                            ToolTip="Ctrl+C. Holds this entity for Ctrl+V in the viewport" />
                    <Button Content="Delete" Padding="7,2" Margin="0,0,6,4" Click="Delete_Click"
                            ToolTip="Del. Removes the selected entities on the next Save" />
                </WrapPanel>

                <TextBlock Text="TRANSFORM" FontSize="9" FontWeight="SemiBold" Foreground="#888" Margin="0,4,0,2" />
                <ItemsControl ItemsSource="{Binding Transform}" />

                <fcbEditor:EntityInspectorView DataContext="{Binding Inspector}" Margin="0,8,0,0" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
