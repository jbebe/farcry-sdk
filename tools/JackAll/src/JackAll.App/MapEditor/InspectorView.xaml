<UserControl x:Class="JackAll.App.MapEditor.InspectorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fcbEditor="clr-namespace:JackAll.App.FileHandlers.Fcb.FcbEditor">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <fcbEditor:PropertyEditorTemplates />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="Visible" />
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
            <TextBlock Text="Select an entity in the hierarchy or the viewport.">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource EmptyHint}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasEntity}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <StackPanel Visibility="{Binding HasEntity, Converter={StaticResource Visible}}">
                <TextBlock Text="{Binding Heading}" Style="{StaticResource Heading}" />
                <TextBlock Text="{Binding Details}" Style="{StaticResource Secondary}" TextWrapping="Wrap" Margin="0,2,0,0" />
                <WrapPanel Margin="0,6,0,4">
                    <Button Content="Open archetype" Style="{StaticResource DenseButton}" Margin="0,0,6,4" IsEnabled="{Binding CanShowArchetype}"
                            Click="ShowArchetype_Click"
                            ToolTip="Opens the Archetypes tab on the archetype this entity merges over" />
                    <Button Content="Open in FCB editor" Style="{StaticResource DenseButton}" Margin="0,0,6,4" IsEnabled="{Binding CanOpenSector}"
                            Click="OpenSector_Click"
                            ToolTip="Opens this entity's own fragment of its sector file. Not for an unsaved addition, which has no fragment yet." />
                    <Button Content="Copy" Style="{StaticResource DenseButton}" Margin="0,0,6,4" Click="Copy_Click"
                            ToolTip="Ctrl+C. Holds this entity for Ctrl+V in the viewport" />
                    <Button Content="Delete" Style="{StaticResource DenseButton}" Margin="0,0,6,4" Click="Delete_Click"
                            ToolTip="Del. Removes the selected entities on the next Save" />
                </WrapPanel>

                <TextBlock Text="TRANSFORM" Style="{StaticResource SectionHeader}" />
                <ItemsControl ItemsSource="{Binding Transform}" />

                <TextBlock Text="LINKS" Style="{StaticResource SectionHeader}" Margin="0,8,0,0"
                           ToolTip="When this entity raises an output, the target receives an event" />
                <ItemsControl ItemsSource="{Binding Links}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="0,1">
                                <Button DockPanel.Dock="Right" Content="×" Style="{StaticResource DenseButton}" Margin="4,0,0,0"
                                        Tag="{Binding}" Click="RemoveLink_Click" ToolTip="Remove this link" />
                                <TextBlock Text="{Binding Text}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text}"
                                           VerticalAlignment="Center" />
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ComboBox IsEditable="True" ItemsSource="{Binding LinkOutputs}" Text="{Binding NewLinkOutput, UpdateSourceTrigger=PropertyChanged}"
                              Margin="0,0,4,0" ToolTip="The output of this entity that fires the link" />
                    <ComboBox Grid.Column="1" ItemsSource="{Binding LinkEvents}" SelectedItem="{Binding NewLinkEvent}"
                              Margin="0,0,4,0" ToolTip="The event the target receives - every kind this world's links send" />
                    <Button Grid.Column="2" Content="Link to…" Style="{StaticResource DenseButton}" Click="LinkPick_Click"
                            ToolTip="Then click the target entity in the viewport. Escape cancels." />
                </Grid>

                <fcbEditor:EntityInspectorView DataContext="{Binding Inspector}" Margin="0,8,0,0" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
