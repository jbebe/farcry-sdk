<!-- The dark theme: the same keys as Brushes.Light.xaml. The Domino canvas is dimmed paper rather
     than dark, because its wire and port palette lives in C# converters tuned for a light ground. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    mc:Ignorable="po">
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FF1E1E1E" po:Freeze="True" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#FF252526" po:Freeze="True" />
    <SolidColorBrush x:Key="SurfaceInertBrush" Color="#FF2D2D30" po:Freeze="True" />
    <SolidColorBrush x:Key="OverlayBrush" Color="#E8252526" po:Freeze="True" />
    <SolidColorBrush x:Key="WellBrush" Color="#FF111111" po:Freeze="True" />
    <SolidColorBrush x:Key="CanvasBrush" Color="#FFB8B8B8" po:Freeze="True" />

    <SolidColorBrush x:Key="ControlBrush" Color="#FF3A3A3D" po:Freeze="True" />
    <SolidColorBrush x:Key="ControlHoverBrush" Color="#FF46464A" po:Freeze="True" />
    <SolidColorBrush x:Key="ControlPressedBrush" Color="#FF55555A" po:Freeze="True" />
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#FF5A5A5E" po:Freeze="True" />
    <SolidColorBrush x:Key="InputBrush" Color="#FF2A2A2C" po:Freeze="True" />
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#FF5A5A5E" po:Freeze="True" />
    <SolidColorBrush x:Key="AccentBrush" Color="#FF4DA3FF" po:Freeze="True" />

    <SolidColorBrush x:Key="BorderHairlineBrush" Color="#FF3C3C3C" po:Freeze="True" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="#FF4A4A4A" po:Freeze="True" />
    <SolidColorBrush x:Key="BorderEmphasisBrush" Color="#FF6A6A6A" po:Freeze="True" />

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFE4E4E4" po:Freeze="True" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#FFB0B0B0" po:Freeze="True" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#FF8C8C8C" po:Freeze="True" />
    <SolidColorBrush x:Key="TextDisabledBrush" Color="#FF6A6A6A" po:Freeze="True" />
    <SolidColorBrush x:Key="LinkBrush" Color="#FF6CB0F0" po:Freeze="True" />

    <SolidColorBrush x:Key="SelectionBrush" Color="#FF264F78" po:Freeze="True" />
    <SolidColorBrush x:Key="SelectionTextBrush" Color="#FFFFFFFF" po:Freeze="True" />
    <SolidColorBrush x:Key="SelectionInactiveBrush" Color="#FF3A3D41" po:Freeze="True" />
    <SolidColorBrush x:Key="SelectionInactiveTextBrush" Color="#FFE4E4E4" po:Freeze="True" />
    <SolidColorBrush x:Key="SelectionSoftBrush" Color="#FF2F4A63" po:Freeze="True" />

    <SolidColorBrush x:Key="WarningBgBrush" Color="#FF3A2F14" po:Freeze="True" />
    <SolidColorBrush x:Key="WarningBorderBrush" Color="#FF7A6220" po:Freeze="True" />
    <SolidColorBrush x:Key="WarningTextBrush" Color="#FFE9C46A" po:Freeze="True" />
    <SolidColorBrush x:Key="WarningAccentBrush" Color="#FFE0A030" po:Freeze="True" />

    <SolidColorBrush x:Key="OkBgBrush" Color="#FF1C3322" po:Freeze="True" />
    <SolidColorBrush x:Key="OkBorderBrush" Color="#FF2F6B3A" po:Freeze="True" />
    <SolidColorBrush x:Key="OkTextBrush" Color="#FF7FD48A" po:Freeze="True" />

    <SolidColorBrush x:Key="DangerBrush" Color="#FFF2777A" po:Freeze="True" />
    <SolidColorBrush x:Key="InvalidBgBrush" Color="#FF4A2426" po:Freeze="True" />

    <SolidColorBrush x:Key="DiffAddedBgBrush" Color="#FF1F3A26" po:Freeze="True" />
    <SolidColorBrush x:Key="DiffAddedTextBrush" Color="#FF9BE3A8" po:Freeze="True" />
    <SolidColorBrush x:Key="DiffRemovedBgBrush" Color="#FF45262A" po:Freeze="True" />
    <SolidColorBrush x:Key="DiffRemovedTextBrush" Color="#FFF2A0A0" po:Freeze="True" />
</ResourceDictionary>
