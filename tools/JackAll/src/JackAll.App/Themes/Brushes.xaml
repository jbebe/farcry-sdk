<!-- One brush per colour. Selection is the exception: it follows the OS accent, not the theme, and
     the inactive pair is what SystemColors.InactiveSelectionHighlightBrush resolves to. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="SurfaceBrush" Color="{DynamicResource SurfaceColor}" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="{DynamicResource SurfaceAltColor}" />
    <SolidColorBrush x:Key="SurfaceInertBrush" Color="{DynamicResource SurfaceInertColor}" />
    <SolidColorBrush x:Key="OverlayBrush" Color="{DynamicResource OverlayColor}" />
    <SolidColorBrush x:Key="WellBrush" Color="{DynamicResource WellColor}" />

    <SolidColorBrush x:Key="BorderHairlineBrush" Color="{DynamicResource BorderHairlineColor}" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="{DynamicResource BorderStrongColor}" />
    <SolidColorBrush x:Key="BorderEmphasisBrush" Color="{DynamicResource BorderEmphasisColor}" />

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{DynamicResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{DynamicResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{DynamicResource TextMutedColor}" />

    <SolidColorBrush x:Key="SelectionBrush" Color="{x:Static SystemColors.HighlightColor}" />
    <SolidColorBrush x:Key="SelectionTextBrush" Color="{x:Static SystemColors.HighlightTextColor}" />
    <SolidColorBrush x:Key="SelectionInactiveBrush" Color="{x:Static SystemColors.ControlColor}" />
    <SolidColorBrush x:Key="SelectionInactiveTextBrush" Color="{x:Static SystemColors.ControlTextColor}" />
    <SolidColorBrush x:Key="SelectionSoftBrush" Color="{DynamicResource SelectionSoftColor}" />

    <SolidColorBrush x:Key="WarningBgBrush" Color="{DynamicResource WarningBgColor}" />
    <SolidColorBrush x:Key="WarningBorderBrush" Color="{DynamicResource WarningBorderColor}" />
    <SolidColorBrush x:Key="WarningTextBrush" Color="{DynamicResource WarningTextColor}" />
    <SolidColorBrush x:Key="WarningAccentBrush" Color="{DynamicResource WarningAccentColor}" />

    <SolidColorBrush x:Key="OkBgBrush" Color="{DynamicResource OkBgColor}" />
    <SolidColorBrush x:Key="OkBorderBrush" Color="{DynamicResource OkBorderColor}" />
    <SolidColorBrush x:Key="OkTextBrush" Color="{DynamicResource OkTextColor}" />

    <SolidColorBrush x:Key="DangerBrush" Color="{DynamicResource DangerColor}" />
    <SolidColorBrush x:Key="InvalidBgBrush" Color="{DynamicResource InvalidBgColor}" />

    <SolidColorBrush x:Key="SplitterBrush" Color="{DynamicResource SplitterColor}" />
</ResourceDictionary>
