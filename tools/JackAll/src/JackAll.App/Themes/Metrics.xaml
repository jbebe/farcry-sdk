<!-- Sizes and spacing. Body text stays at WPF's default 12. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <sys:Double x:Key="FontSizeCaption">9</sys:Double>
    <sys:Double x:Key="FontSizeSmall">10</sys:Double>
    <sys:Double x:Key="FontSizeSecondary">11</sys:Double>
    <sys:Double x:Key="FontSizeHeading">14</sys:Double>
    <FontFamily x:Key="MonoFont">Consolas</FontFamily>

    <Thickness x:Key="ButtonPadding">10,5</Thickness>
    <Thickness x:Key="DensePadding">6,1</Thickness>
    <Thickness x:Key="PrimaryPadding">16,7</Thickness>
    <Thickness x:Key="InputPadding">4,2</Thickness>
    <Thickness x:Key="CalloutPadding">10,7</Thickness>
    <CornerRadius x:Key="CalloutRadius">2</CornerRadius>
    <GridLength x:Key="SplitterSize">4</GridLength>
</ResourceDictionary>
