<!-- Never set Background here: SearchBox paints its placeholder into TextBox.Background. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:JackAll.App">
    <local:PlaceholderBrushConverter x:Key="PlaceholderBrush" />

    <Style TargetType="TextBox">
        <Setter Property="Padding" Value="{DynamicResource InputPadding}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="Padding" Value="{DynamicResource InputPadding}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!-- A filter box whose Tag is its placeholder: a string, or a TextBlock for rich text. -->
    <Style x:Key="SearchBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="Tag" Value="Filter…" />
        <Style.Triggers>
            <Trigger Property="Text" Value="">
                <Setter Property="Background"
                        Value="{Binding Tag, RelativeSource={RelativeSource Self}, Converter={StaticResource PlaceholderBrush}}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Editors whose DataContext exposes IsValid. -->
    <Style x:Key="ValidatedTextBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsValid}" Value="False">
                <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
                <Setter Property="Background" Value="{DynamicResource InvalidBgBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ValidatedComboBox" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsValid}" Value="False">
                <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
                <Setter Property="Background" Value="{DynamicResource InvalidBgBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
