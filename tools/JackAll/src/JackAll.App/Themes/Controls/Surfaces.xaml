<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Every tab's first row. -->
    <Style x:Key="TabToolbar" TargetType="DockPanel">
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <!-- Fills its grid cell; a SplitterSize row or column gives it its thickness. -->
    <Style TargetType="GridSplitter">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="Background" Value="{DynamicResource SplitterBrush}" />
    </Style>

    <!-- A boxed sentence the reader should not miss; its text inherits the colour and size. -->
    <Style x:Key="WarningCallout" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource WarningBgBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource WarningBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="{DynamicResource CalloutPadding}" />
        <Setter Property="CornerRadius" Value="{DynamicResource CalloutRadius}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource WarningTextBrush}" />
        <Setter Property="TextElement.FontSize" Value="{DynamicResource FontSizeSecondary}" />
    </Style>

    <Style x:Key="OkCallout" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource OkBgBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource OkBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="{DynamicResource CalloutPadding}" />
        <Setter Property="CornerRadius" Value="{DynamicResource CalloutRadius}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource OkTextBrush}" />
        <Setter Property="TextElement.FontSize" Value="{DynamicResource FontSizeSecondary}" />
    </Style>

    <Style x:Key="PopupSurface" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderEmphasisBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10,8" />
    </Style>

    <!-- The frame around a file preview: text, image, model. -->
    <Style x:Key="PreviewFrame" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderHairlineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <!-- The frame around something that is not a live document: a panel, a notice, a raw dump. -->
    <Style x:Key="InertFrame" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SurfaceInertBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderHairlineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
</ResourceDictionary>
