<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:JackAll.App">
    <!-- A non-selectable tab that draws only a thin rule, separating the fixed tabs from document tabs. -->
    <Style x:Key="TabDivider" TargetType="TabItem">
        <Setter Property="IsEnabled" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Rectangle Width="1" Margin="6,3" Fill="{DynamicResource BorderEmphasisBrush}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A document tab: its Header is the title, its Tag the close action the × runs. -->
    <Style x:Key="DocumentTab" TargetType="TabItem">
        <Setter Property="HeaderTemplate">
            <Setter.Value>
                <DataTemplate>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{DynamicResource DenseButton}" Content="×"
                                Margin="6,0,0,0" VerticalAlignment="Center" Focusable="False" ToolTip="Close (Ctrl+W)"
                                Command="{x:Static local:MainWindow.CloseDocumentTabCommand}"
                                CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=TabItem}}" />
                        <TextBlock Text="{Binding}" VerticalAlignment="Center" />
                    </DockPanel>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
