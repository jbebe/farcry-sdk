<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- The name of whatever a details pane shows. -->
    <Style x:Key="Heading" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeHeading}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- An upper-case label over a group of fields. -->
    <Style x:Key="SectionHeader" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeTiny}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
        <Setter Property="Margin" Value="0,12,0,4" />
    </Style>

    <!-- Body-size text that matters less than what it sits beside: a field label, a count. -->
    <Style x:Key="Secondary" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>

    <Style x:Key="Muted" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    </Style>

    <!-- A sentence of guidance under a control. -->
    <Style x:Key="Note" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeSecondary}" />
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- The smallest text: a detail beside a value. -->
    <Style x:Key="Caption" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}" />
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    </Style>

    <Style x:Key="Mono" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource MonoFont}" />
    </Style>

    <Style x:Key="MonoSmall" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource MonoFont}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeSecondary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- A dump or a path in monospace that matters less than the value it explains. -->
    <Style x:Key="MonoNote" TargetType="TextBlock" BasedOn="{StaticResource MonoSmall}">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>

    <Style x:Key="ToolbarLabel" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,0,6,0" />
    </Style>

    <Style x:Key="StatusText" TargetType="TextBlock">
        <Setter Property="DockPanel.Dock" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="16,0,0,0" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- The "Select a ... to ..." text an empty details pane shows. -->
    <Style x:Key="EmptyHint" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- A muted line inside a template cell. Its own Foreground would stay grey on the selection
         highlight, so it follows the row's selection itself. -->
    <Style x:Key="GridMutedText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeSecondary}" />
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
        <Style.Triggers>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True" />
                    <Condition Binding="{Binding Path=(Selector.IsSelectionActive), RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True" />
                </MultiDataTrigger.Conditions>
                <Setter Property="Foreground" Value="{DynamicResource SelectionTextBrush}" />
            </MultiDataTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
