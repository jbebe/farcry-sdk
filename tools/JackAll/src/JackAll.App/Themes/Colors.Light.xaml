<!-- Every colour the app paints with. A dark theme is a second copy of this file. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="SurfaceColor">#FFFFFFFF</Color>
    <Color x:Key="SurfaceAltColor">#FFFAFAFA</Color>
    <Color x:Key="SurfaceInertColor">#FFECECEC</Color>
    <Color x:Key="OverlayColor">#E8FFFFFF</Color>
    <Color x:Key="WellColor">#FF222222</Color>

    <Color x:Key="BorderHairlineColor">#FFDDDDDD</Color>
    <Color x:Key="BorderStrongColor">#FFCCCCCC</Color>
    <Color x:Key="BorderEmphasisColor">#FFAAAAAA</Color>

    <Color x:Key="TextPrimaryColor">#FF000000</Color>
    <Color x:Key="TextSecondaryColor">#FF666666</Color>
    <Color x:Key="TextMutedColor">#FF888888</Color>

    <Color x:Key="SelectionSoftColor">#FFCCE4F7</Color>

    <Color x:Key="WarningBgColor">#FFFFF4E0</Color>
    <Color x:Key="WarningBorderColor">#FFE0C060</Color>
    <Color x:Key="WarningTextColor">#FF6B4E10</Color>
    <Color x:Key="WarningAccentColor">#FFE08A00</Color>

    <Color x:Key="OkBgColor">#FFEAF6EA</Color>
    <Color x:Key="OkBorderColor">#FFA8D2A8</Color>
    <Color x:Key="OkTextColor">#FF2A7A2A</Color>

    <Color x:Key="DangerColor">#FFBB0000</Color>
    <Color x:Key="InvalidBgColor">#FFFFF0F0</Color>

    <Color x:Key="SplitterColor">#00000000</Color>
</ResourceDictionary>
