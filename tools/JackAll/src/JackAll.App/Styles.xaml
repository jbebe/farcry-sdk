<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:JackAll.App">
    <local:PlaceholderBrushConverter x:Key="PlaceholderBrush" />

    <!-- A non-selectable tab that draws only a thin rule, separating the fixed tabs from document tabs. -->
    <Style x:Key="TabDivider" TargetType="TabItem">
        <Setter Property="IsEnabled" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Rectangle Width="1" Margin="6,3"
                               Fill="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Every tab's first row. -->
    <Style x:Key="TabToolbar" TargetType="DockPanel">
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <Style x:Key="ToolbarLabel" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,0,6,0" />
    </Style>

    <Style x:Key="StatusText" TargetType="TextBlock">
        <Setter Property="DockPanel.Dock" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="16,0,0,0" />
        <Setter Property="Foreground" Value="#666" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- The "Select a ... to ..." text an empty details pane shows. -->
    <Style x:Key="EmptyHint" TargetType="TextBlock">
        <Setter Property="Foreground" Value="#888" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- A filter box whose Tag is its placeholder: a string, or a TextBlock for rich text. -->
    <Style x:Key="SearchBox" TargetType="TextBox">
        <Setter Property="Padding" Value="4,2" />
        <Setter Property="Tag" Value="Filter…" />
        <Style.Triggers>
            <Trigger Property="Text" Value="">
                <Setter Property="Background"
                        Value="{Binding Tag, RelativeSource={RelativeSource Self}, Converter={StaticResource PlaceholderBrush}}" />
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
