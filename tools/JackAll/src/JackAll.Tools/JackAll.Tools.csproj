<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Everything you inspect or convert one file at a time: the standalone asset formats (textures,
    models, audio, terrain, savegames) and the Domino mission-graph Lua.

    Split out of JackAll.Core so the mod pipeline doesn't drag it along. Core is what the lean
    `jackall-mi` installer publishes, and none of this is reachable from `mod build`/`mod import-legacy` -
    keeping it here is what lets that exe stay trimmable and Loretta-free.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\JackAll.Core\JackAll.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Parses the game's Domino mission-graph Lua (Domino\). -->
    <PackageReference Include="BCnEncoder.Net" Version="2.3.0" />
    <PackageReference Include="Loretta.CodeAnalysis.Lua" Version="0.2.13" />
  </ItemGroup>

  <ItemGroup>
    <!-- FreeType, which Mft\FontRaster draws a font file's glyphs with. -->
    <PackageReference Include="FreeTypeSharp" Version="3.1.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Recast, which World\NavMeshGenerator voxelises a level's walkable surface with. -->
    <PackageReference Include="DotRecast.Recast" Version="2026.3.1" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Domino\Nodes\DominoBoxDocs.json" LogicalName="JackAll.Tools.Domino.Nodes.DominoBoxDocs.json" />
    <EmbeddedResource Include="Hkx\HavokClasses.json" LogicalName="JackAll.Tools.Hkx.HavokClasses.json" />
  </ItemGroup>

</Project>
