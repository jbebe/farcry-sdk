<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- The game export the retail fixtures are linked out of; one place to repoint if it moves. -->
    <Fc2Graphics>..\..\..\..\tmp\gamefiles\worlds\worlds\graphics</Fc2Graphics>
    <Fc2Levels>..\..\..\..\tmp\gamefiles\worlds\worlds\levels</Fc2Levels>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Loretta.CodeAnalysis.Lua" Version="0.2.13" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\JackAll.Core\JackAll.Core.csproj" />
    <ProjectReference Include="..\JackAll.Tools\JackAll.Tools.csproj" />
    <!-- For CommandLineTests only: jackall-mi's argument parser. -->
    <ProjectReference Include="..\JackAll.ModInstaller\JackAll.ModInstaller.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Fixtures\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\assets\binary_classes.xml" Link="Fixtures\Fcb\binary_classes.xml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- Retail meshes from the local game export; absent on CI, where the fixture-guarded tests
         no-op. The format-samples meshes are NOT used: their provenance is unknown. -->
    <Content Include="$(Fc2Graphics)\actors\buddy_andrehyppolite\andrehyppolite.xbg"
             Link="Fixtures\Xbg\andrehyppolite.xbg"
             Condition="Exists('$(Fc2Graphics)\actors\buddy_andrehyppolite\andrehyppolite.xbg')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="$(Fc2Graphics)\objects\furnitures\chairs\chairbar01.xbg"
             Link="Fixtures\Xbg\chairbar01.xbg"
             Condition="Exists('$(Fc2Graphics)\objects\furnitures\chairs\chairbar01.xbg')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="$(Fc2Graphics)\vehicles\land\buggy\buggy.xbg"
             Link="Fixtures\Xbg\buggy.xbg"
             Condition="Exists('$(Fc2Graphics)\vehicles\land\buggy\buggy.xbg')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- Carries both damage states of its body and of all three roof pieces. -->
    <Content Include="$(Fc2Graphics)\vehicles\sea\swampboat\swampboat.xbg"
             Link="Fixtures\Xbg\swampboat.xbg"
             Condition="Exists('$(Fc2Graphics)\vehicles\sea\swampboat\swampboat.xbg')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- The checked-in Fixtures\Xbm samples are all opaque; these two carry the alpha flags. -->
    <Content Include="$(Fc2Graphics)\_materials\cromagnoli-m-2008030651031699.xbm"
             Link="Fixtures\XbmAlpha\blended.xbm"
             Condition="Exists('$(Fc2Graphics)\_materials\cromagnoli-m-2008030651031699.xbm')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="$(Fc2Graphics)\_materials\aamancio-m-2007111374254074.xbm"
             Link="Fixtures\XbmAlpha\masked.xbm"
             Condition="Exists('$(Fc2Graphics)\_materials\aamancio-m-2007111374254074.xbm')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- Layer 1 is a flat colour swatch on both, which is what made the second layer visible in the
         first place: one keeps a real texture in layer 2, the other repeats the swatch there. -->
    <Content Include="$(Fc2Graphics)\_materials\apare-m-2007102557105961.xbm"
             Link="Fixtures\XbmSwatch\swaps.xbm"
             Condition="Exists('$(Fc2Graphics)\_materials\apare-m-2007102557105961.xbm')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="$(Fc2Graphics)\_materials\apare-m-2008041046168921.xbm"
             Link="Fixtures\XbmSwatch\flat.xbm"
             Condition="Exists('$(Fc2Graphics)\_materials\apare-m-2008041046168921.xbm')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- A landmark file that places a colonial house: its shell, its window-and-door panel, and a
         second building, beside the vegetation container and spline volumes that must not load. -->
    <Content Include="$(Fc2Levels)\w2_b_2\generated\worldsectors\landmarknear4427.data.fcb"
             Link="Fixtures\WorldSector\landmarknear4427.data.fcb"
             Condition="Exists('$(Fc2Levels)\w2_b_2\generated\worldsectors\landmarknear4427.data.fcb')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- A terrain layer texture and the "_mip0.xbt" its header names, which is where its real top
         level lives; plus one from the same folder whose header names nothing, so both branches of
         the companion lookup are covered. Kept to the smallest such pair in the tree. -->
    <Content Include="$(Fc2Graphics)\terrain\_textures\savannah\stiresjunk01_d.xbt"
             Link="Fixtures\XbtStreamed\stiresjunk01_d.xbt"
             Condition="Exists('$(Fc2Graphics)\terrain\_textures\savannah\stiresjunk01_d.xbt')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="$(Fc2Graphics)\terrain\_textures\savannah\stiresjunk01_d_mip0.xbt"
             Link="Fixtures\XbtStreamed\stiresjunk01_d_mip0.xbt"
             Condition="Exists('$(Fc2Graphics)\terrain\_textures\savannah\stiresjunk01_d_mip0.xbt')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="$(Fc2Graphics)\terrain\_textures\desert\desert_sand_still_d.xbt"
             Link="Fixtures\XbtStreamed\desert_sand_still_d.xbt"
             Condition="Exists('$(Fc2Graphics)\terrain\_textures\desert\desert_sand_still_d.xbt')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- One of the six camera-facing vegetation impostors and the material that marks it a
         billboard - two of the 2,208 shipped materials set that flag, and these six meshes are all
         that use them. -->
    <Content Include="$(Fc2Graphics)\vegetation\jungle\realtrees\donotuse\facingbush.xbg"
             Link="Fixtures\Billboard\facingbush.xbg"
             Condition="Exists('$(Fc2Graphics)\vegetation\jungle\realtrees\donotuse\facingbush.xbg')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="$(Fc2Graphics)\_materials\dboivin-m-2008041150042062.xbm"
             Link="Fixtures\Billboard\facingbush.xbm"
             Condition="Exists('$(Fc2Graphics)\_materials\dboivin-m-2008041150042062.xbm')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- One RealTree of each kind the format has: a savannah tree whose foliage is flat cards, and
         a jungle plant whose leaves are modelled meshes. Their arenas are packed differently, so a
         stride wrong in either walk shows up in exactly one of them. -->
    <Content Include="$(Fc2Graphics)\vegetation\savannah\realtrees\rt_tree_acacia.rtx"
             Link="Fixtures\Rtx\rt_tree_acacia.rtx"
             Condition="Exists('$(Fc2Graphics)\vegetation\savannah\realtrees\rt_tree_acacia.rtx')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="$(Fc2Graphics)\vegetation\jungle\realtrees\hy_bigleaf.rtx"
             Link="Fixtures\Rtx\hy_bigleaf.rtx"
             Condition="Exists('$(Fc2Graphics)\vegetation\jungle\realtrees\hy_bigleaf.rtx')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- One baked terrain albedo atlas, stored in the cooker's per-sector transpose. Picked for
         having the strongest discontinuity at its internal sector seam of any in the level, so a
         mirror that got the direction wrong could not pass unnoticed. -->
    <Content Include="$(Fc2Levels)\w1_a_1\generated\sdat\atlas5126_diffuse.xbt"
             Link="Fixtures\Sdat\atlas5126_diffuse.xbt"
             Condition="Exists('$(Fc2Levels)\w1_a_1\generated\sdat\atlas5126_diffuse.xbt')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>