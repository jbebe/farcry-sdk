<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Loretta.CodeAnalysis.Lua" Version="0.2.13" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\JackAll.Core\JackAll.Core.csproj" />
    <ProjectReference Include="..\JackAll.Tools\JackAll.Tools.csproj" />
    <!-- For CommandLineTests only: jackall-mi's argument parser. -->
    <ProjectReference Include="..\JackAll.ModInstaller\JackAll.ModInstaller.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Fixtures\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\assets\binary_classes.xml" Link="Fixtures\Fcb\binary_classes.xml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- Retail meshes from the local game export; absent on CI, where the fixture-guarded tests
         no-op. The format-samples meshes are NOT used: their provenance is unknown. -->
    <Content Include="..\..\..\..\tmp\graphics\actors\buddy_andrehyppolite\andrehyppolite.xbg"
             Link="Fixtures\Xbg\andrehyppolite.xbg"
             Condition="Exists('..\..\..\..\tmp\graphics\actors\buddy_andrehyppolite\andrehyppolite.xbg')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\..\..\tmp\graphics\objects\furnitures\chairs\chairbar01.xbg"
             Link="Fixtures\Xbg\chairbar01.xbg"
             Condition="Exists('..\..\..\..\tmp\graphics\objects\furnitures\chairs\chairbar01.xbg')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>