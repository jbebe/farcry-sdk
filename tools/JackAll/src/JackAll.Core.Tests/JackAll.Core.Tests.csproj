<Project Sdk="Microsoft.NET.Sdk">

  <!--
    net10.0-windows only because the Domino\ tests cover code that lives in JackAll.App (see that
    csproj for why Domino sits there rather than in JackAll.Core), and referencing a WPF exe means
    matching its target framework. Deliberately *not* UseWPF: nothing here uses WPF, and turning it
    on swaps the SDK's implicit-usings set for the desktop one, which drops System.IO and breaks
    every test in this project that touches a Stream.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Loretta.CodeAnalysis.Lua" Version="0.2.13" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\JackAll.Core\JackAll.Core.csproj" />
    <ProjectReference Include="..\JackAll.App\JackAll.App.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Fixtures\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\assets\binary_classes.xml" Link="Fixtures\Fcb\binary_classes.xml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Fixtures\Sbao\" />
    <Folder Include="Fixtures\Rml\" />
    <Folder Include="Fixtures\Xbm\" />
    <Folder Include="Fixtures\Spk\" />
  </ItemGroup>

</Project>