<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>JackAll.Cli</RootNamespace>
    <!-- Not "jackall": Windows filesystems are case-insensitive, so that would collide with the
         App's JackAll.exe if a user ever put both in the same folder or on PATH. -->
    <AssemblyName>jackall-cli</AssemblyName>
  </PropertyGroup>

  <!--
    Same self-contained single-file publish as JackAll.App (see that csproj for the full rationale):
    a user should be able to run jackall.exe with no .NET runtime installed and nothing loose beside
    it. Gated on _IsPublishing so `dotnet build`/`dotnet test` stay fast framework-dependent builds.
    Trimming is left off even though this is a plain console app (no WPF constraint here) because
    Spectre.Console.Cli's command discovery relies on reflection that trimming isn't guaranteed to
    preserve without explicit annotations.
  -->
  <PropertyGroup Condition="'$(_IsPublishing)' == 'true'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishReadyToRun>true</PublishReadyToRun>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <DebugType>none</DebugType>
    <AllowedReferenceRelatedFileExtensions>none</AllowedReferenceRelatedFileExtensions>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\JackAll.Core\JackAll.Core.csproj" />
    <ProjectReference Include="..\JackAll.Tools\JackAll.Tools.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Spectre.Console.Cli" Version="0.55.0" />
  </ItemGroup>

  <!--
    Same assets the App ships: the hash dictionary gives an unpacked archive real filenames where
    they're known, and the class config is what lets deep unpack resolve an .fcb's field names when
    decoding it to XML instead of just BinHex/hash-only.
  -->
  <ItemGroup>
    <Content Include="..\..\assets\fc2.hashlist" Link=".itemhashes">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\assets\binary_classes.xml" Link=".fcbclasses">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\assets\engine-roots.tsv" Link=".engineroots">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
